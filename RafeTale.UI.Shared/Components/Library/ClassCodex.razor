@using RafeTale.Application.DTOs
@using RafeTale.Application.Interfaces.DtosInterfaces
@using RafeTale.Domain.Entities
@inject IService<ClassDefinitionDto, ClassDefinition> ClassService
@inject IStringLocalizer<LibraryStrings> LL

@if (isLoading)
{
    <div class="text-center py-8 text-amber-500 font-mono animate-pulse">
        @LL["ClassCodex_Loading"]
    </div>
}
else if (inspectedClass == null)
{
    <ClassList Classes="classes" OnClassSelected="InspectClass" />
}
else
{
    <div class="mb-4">
        <button @onclick="BackToList"
                class="text-amber-500 hover:text-amber-400 font-mono text-sm flex items-center gap-2 transition-colors">
            <span class="text-lg">←</span> @LL["ClassCodex_BackToList"]
        </button>
    </div>
    <ClassInspector InspectedClass="inspectedClass" />
}

@code {
    private List<ClassDefinitionDto> classes = [];
    private ClassDefinitionDto? inspectedClass;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        classes = await ClassService.GetAllAsync(null, null);
        isLoading = false;
    }

    private void InspectClass(ClassDefinitionDto dto) => inspectedClass = dto;
    private void BackToList() => inspectedClass = null;
}
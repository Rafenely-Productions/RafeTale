@using Application.DTOs
@using Domain.Enums
@inject IStringLocalizer<AppStrings> L
@inject IJSRuntime JS

<div class="animate-in fade-in duration-300 space-y-6 max-w-4xl mx-auto pb-4">

    <div class="border-b border-slate-800 pb-5">
        <div class="flex items-center gap-3 mb-2">
            <h1 class="text-4xl font-black text-white uppercase italic tracking-tight">@FeatDto.Name</h1>
            @if (FeatDto?.Category != null)
            {
                <span class="text-[10px] font-mono bg-amber-500/10 text-amber-500 px-2.5 py-1 rounded-lg border border-amber-500/20 uppercase tracking-wider">
                    @L["CategoryFeat_"+FeatDto.Category]
                </span>
            }
        </div>
        <p class="text-slate-400 font-sans text-sm leading-relaxed mt-3">
            @((MarkupString)FeatDto.Description)
        </p>
    </div>

    @if (FeatDto.Prerequisite != null && FeatDto.Prerequisite.Any())
    {
        <div class="p-4 bg-slate-900/40 rounded-xl border border-slate-800">
            <p class="text-[10px] font-bold text-amber-500 uppercase tracking-widest mb-2">@L["Feat_Prerequisite"]</p>
            <div class="flex flex-wrap gap-2">
                @foreach (var req in FeatDto.Prerequisite)
                {
                    <span class="text-xs text-slate-300 font-sans bg-slate-950 border border-slate-800 px-2.5 py-1 rounded-lg">
                        @req
                    </span>
                }
            </div>
        </div>
    }

</div>

@code {
    [Parameter] public FeatDto FeatDto { get; set; } = null!;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "document.getElementById('main-scroll-view')?.scrollTo({ top: 0, behavior: 'instant' });");
        }
        catch { }
    }
}
@using Microsoft.AspNetCore.Components.Routing
@using Rafedream.UI.Shared.Pages
@using Rafedream.UI.Shared.Shared

<Router AppAssembly="@typeof(Main).Assembly"
        AdditionalAssemblies="new[] { typeof(Rafedream.UI.Shared.Pages.SandboxPage).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Rafedream.UI.Shared.Shared.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Rafedream.UI.Shared.Shared.MainLayout)">
            <p role="alert">No hay nada aquí. Parece que fallaste tu tirada de Percepción.</p>
        </LayoutView>
    </NotFound>
</Router>


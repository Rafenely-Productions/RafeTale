@page "/library"
@using Rafedream.Domain.Enums
@using Rafedream.Application.DTOs
@using Rafedream.Application.Interfaces
@using Rafedream.UI.Shared.Components.Library
@inject ILibraryCountsService CountsService
@inject IStringLocalizer<LibraryStrings> LL
@inject IJSRuntime JS

<div @ref="containerRef" class="w-full max-w-7xl mx-auto px-2 sm:px-4 py-2 text-white h-auto min-h-fit">
    @if (SelectedTab == CodexKey.None)
    {
        @if (counts == null)
        {
            <div class="text-center py-12 text-amber-500 font-mono animate-pulse">
                @LL["Library_LoadingCounts"]
            </div>
        }
        else
        {
            <LibraryGrid ClassesCount="counts.Classes"
                         RacesCount="counts.Races"
                         SpellsCount="counts.Spells"
                         BackgroundsCount="counts.Backgrounds"
                         FeatsCount="counts.Feats"
                         OnTabSelected="NavigateToTab" />
        }
    }
    else
    {
        <div class="absolute left-0 z-50">
            <LibraryNavigationBar IsAtRoot="false"
                                  IsInspecting="false"
                                  OnBackToLibrary="() => NavigateToTab(CodexKey.None)"/>
        </div>
        <div class="relative rounded-xl border border-slate-800 bg-slate-900/60 p-3 sm:p-6 shadow-2xl h-auto pt-14">
            <div class="w-full">
                @switch (SelectedTab)
                {
                    case CodexKey.Classes:
                        <ClassCodex />
                        break;
                    case CodexKey.Races:
                        <RaceCodex />
                        break;
                    case CodexKey.Spells:
                        <SpellCodex />
                        break;
                    case CodexKey.Backgrounds:
                        <BackgroundCodex />
                        break;
                    case CodexKey.Feats:
                        <FeatCodex />
                        break;
                    case CodexKey.Rules:
                        <XpProgressionTable />
                        break;
                }
            </div>
        </div>
    }
</div>

@code {
    private ElementReference containerRef;
    private CodexKey SelectedTab = CodexKey.None;
    private LibraryCounts? counts;
    private double savedScrollPosition = 0;

    protected override async Task OnInitializedAsync()
    {
        counts = await CountsService.GetCountsAsync();
    }

    private async Task NavigateToTab(CodexKey key)
    {
        if (SelectedTab == CodexKey.None && key != CodexKey.None)
        {
            savedScrollPosition = await GetScrollPositionAsync();
        }

        SelectedTab = key;

        if (key == CodexKey.None)
        {
            await RestoreScrollAsync(savedScrollPosition);
        }

        StateHasChanged();
    }

    private async Task<double> GetScrollPositionAsync()
    {
        try
        {
            return await JS.InvokeAsync<double>("eval", "document.getElementById('main-scroll-view')?.scrollTop || 0");
        }
        catch { return 0; }
    }

    private async Task RestoreScrollAsync(double position)
    {
        try
        {
            await JS.InvokeVoidAsync("eval", $"document.getElementById('main-scroll-view')?.scrollTo({{ top: {position}, behavior: 'instant' }});");
        }
        catch { }
    }
}
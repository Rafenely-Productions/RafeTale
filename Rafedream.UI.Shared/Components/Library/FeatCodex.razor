@using Rafedream.Application.DTOs
@using Rafedream.Application.Interfaces.DtosInterfaces
@using Rafedream.Domain.Entities
@inject IService<FeatDto, Feat> FeatService
@inject IStringLocalizer<LibraryStrings> LL

@if (isLoading)
{
    <div class="text-center py-8 text-amber-500 font-mono animate-pulse">
        @LL["FeatCodex_Loading"]
    </div>
}
else if (inspectedFeat == null)
{
    <FeatList Feats="feats" OnInspectedFeat="InspectFeat" />
}
else
{
    <div class="mb-4">
        <button @onclick="BackToList"
                class="text-amber-500 hover:text-amber-400 font-mono text-sm flex items-center gap-2 transition-colors">
            <span class="text-lg">←</span> @LL["FeatCodex_BackToList"]
        </button>
    </div>
    <FeatInspector FeatDto="inspectedFeat" />
}

@code {
    private List<FeatDto> feats = [];
    private FeatDto? inspectedFeat;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        feats = await FeatService.GetAllAsync(null, null);
        isLoading = false;
    }

    private void InspectFeat(FeatDto dto) => inspectedFeat = dto;
    private void BackToList() => inspectedFeat = null;
}
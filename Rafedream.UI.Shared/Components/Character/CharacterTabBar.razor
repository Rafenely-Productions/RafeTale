@using Rafedream.Domain.Enums

@inject IStringLocalizer<AppStrings> L

<div class="flex bg-slate-950 p-1 rounded-2xl border border-slate-800/80 gap-1 overflow-x-auto">
    <button @onclick="() => OnTabChanged.InvokeAsync(CharacterTab.Spells)"
            class="flex-1 py-2 px-3 rounded-xl text-xs font-black uppercase tracking-wider transition-all whitespace-nowrap @(ActiveTab == CharacterTab.Spells ? "bg-amber-500 text-black shadow" : "text-slate-400 hover:text-white")">
        <i class="fa-solid fa-wand-magic-sparkles mr-1.5"></i> @L["Tab_Grimoire"]
    </button>
    <button @onclick="() => OnTabChanged.InvokeAsync(CharacterTab.Skills)"
            class="flex-1 py-2 px-3 rounded-xl text-xs font-black uppercase tracking-wider transition-all whitespace-nowrap @(ActiveTab == CharacterTab.Skills ? "bg-amber-500 text-black shadow" : "text-slate-400 hover:text-white")">
        <i class="fa-solid fa-list-check mr-1.5"></i> @L["Tab_Skills"]
    </button>
    <button @onclick="() => OnTabChanged.InvokeAsync(CharacterTab.Features)"
            class="flex-1 py-2 px-3 rounded-xl text-xs font-black uppercase tracking-wider transition-all whitespace-nowrap @(ActiveTab == CharacterTab.Features ? "bg-amber-500 text-black shadow" : "text-slate-400 hover:text-white")">
        <i class="fa-solid fa-scroll mr-1.5"></i> @L["Tab_Features"]
    </button>
</div>

@code {
    [Parameter] public CharacterTab ActiveTab { get; set; }
    [Parameter] public EventCallback<CharacterTab> OnTabChanged { get; set; }
}
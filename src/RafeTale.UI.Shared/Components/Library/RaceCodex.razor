@using RafeTale.Application.DTOs
@using RafeTale.Application.Interfaces.DtosInterfaces
@using RafeTale.Domain.Entities
@inject IService<RaceDto, Race> RaceService
@inject IStringLocalizer<LibraryStrings> LL

@if (isLoading)
{
    <div class="text-center py-8 text-amber-500 font-mono animate-pulse">
        @LL["RaceCodex_Loading"]
    </div>
}
else if (inspectedRace == null)
{
    <RaceList Races="races" OnInspectedRace="InspectRace" />
}
else
{
    <div class="mb-4">
        <button @onclick="BackToList"
                class="text-amber-500 hover:text-amber-400 font-mono text-sm flex items-center gap-2 transition-colors">
            <span class="text-lg">←</span> @LL["RaceCodex_BackToList"]
        </button>
    </div>
    <RaceInspector RaceDto="inspectedRace" />
}

@code {
    private List<RaceDto> races = [];
    private RaceDto? inspectedRace;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        races = await RaceService.GetAllAsync(null, includes: query => query
            .Include(x => x.Languages)
            .IncludeCollection(x => x.SubRaces, z => z.Traits)
            .Include(x => x.Traits));
        isLoading = false;
    }

    private void InspectRace(RaceDto dto) => inspectedRace = dto;
    private void BackToList() => inspectedRace = null;
}
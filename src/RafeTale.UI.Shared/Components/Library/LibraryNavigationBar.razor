@inject IStringLocalizer<LibraryStrings> LL

@if (IsAtRoot)
{
    // No muestra nada si estamos en el grid principal (CodexKey.None)
}
else if (!IsInspecting)
{
    <button type="button" @onclick="OnBackToLibrary"
            title="@LL["Back_Li1braryBtn"]"
            class="fixed top-5 left-0 z-30 px-3 py-1.5 rounded bg-slate-800 text-amber-400 hover:bg-slate-700 flex items-center gap-2">
        <i class="fa-solid fa-arrow-left text-sm"></i>
    </button>
}

@code {
    [Parameter] public bool IsAtRoot { get; set; }
    [Parameter] public bool IsInspecting { get; set; }
    [Parameter] public EventCallback OnBackToLibrary { get; set; }
}
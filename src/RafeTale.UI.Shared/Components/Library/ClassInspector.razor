@using Application.DTOs;
@using RafeTale.Application.Interfaces.DtosInterfaces

@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<LibraryStrings> LL
@inject IService<ClassDefinitionDto, ClassDefinition> ClassService
@inject IJSRuntime JS

<div class="animate-in fade-in duration-300 space-y-6">
    @if (_fullClass == null)
    {
        <div class="flex items-center justify-center p-12">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-amber-500"></div>
        </div>
    }
    else
    {
        <div class="flex flex-col lg:flex-row items-start gap-6 border-b border-white/5 pb-6 w-full">
            <div class="flex-1 min-w-0 w-full">
                <h1 class="text-4xl font-black text-white uppercase italic tracking-tight">@_fullClass.TechnicalName</h1>
            </div>

            <div class="flex flex-col justify-start w-full lg:w-80 shrink-0 mt-4 lg:mt-0">
                <h3 class="text-amber-500 font-black text-[10px] tracking-[0.2em] uppercase mb-2 flex items-center gap-2">
                    <i class="fa-solid fa-list-check"></i> @L["Class_Basic_Atributes"]
                </h3>

                <div class="w-full rounded-xl border border-slate-800/80 bg-black/30 shadow-xl overflow-hidden">
                    <table class="w-full text-sm border-collapse">
                        <tbody>
                            <tr class="border-b border-slate-800/40 hover:bg-white/5 transition-colors">
                                <td class="px-3 py-2.5 font-bold text-slate-400 uppercase text-[11px] tracking-wider bg-slate-900/30 w-1/2">
                                    @LL["Primary_Stat"]
                                </td>
                                <td class="px-3 py-2.5 font-sans font-bold text-amber-400 text-right">
                                    @string.Join(" / ", _fullClass.PrimaryAbility.Select(a => L[a.ToString()].Value))
                                </td>
                            </tr>
                            <tr class="border-b border-slate-800/40 hover:bg-white/5 transition-colors">
                                <td class="px-3 py-2.5 font-bold text-slate-400 uppercase text-[11px] tracking-wider bg-slate-900/30">
                                    @L["Hit_Die"]
                                </td>
                                <td class="px-3 py-2.5 font-mono font-black text-red-400 text-right text-base">
                                    @_fullClass.HitDie
                                </td>
                            </tr>
                            <tr class="border-b border-slate-800/40 hover:bg-white/5 transition-colors">
                                <td class="px-3 py-2.5 font-bold text-slate-400 uppercase text-[11px] tracking-wider bg-slate-900/30">
                                    @L["Saving_Throws"]
                                </td>
                                <td class="px-3 py-2.5 font-sans font-medium text-slate-300 text-right text-xs">
                                    @string.Join(" / ", _fullClass.SavingThrowProficiencies.Select(a => L[a.ToString()].Value))
                                </td>
                            </tr>
                            <tr class="border-b border-slate-800/40 hover:bg-white/5 transition-colors">
                                <td class="px-3 py-2.5 font-bold text-slate-400 uppercase text-[11px] tracking-wider bg-slate-900/30">
                                    @L["Skill_Proficiencies"]
                                </td>
                                <td class="px-1 py-2.5 font-sans font-medium text-slate-300 text-right text-xs">
                                    @string.Join(", ", _fullClass.SkillProficiencies.Select(a => L[a!].Value))
                                </td>
                            </tr>
                            @if (_fullClass.ToolProficiencies.Any())
                            {
                                <tr class="border-b border-slate-800/40 hover:bg-white/5 transition-colors">
                                    <td class="px-3 py-2.5 font-bold text-slate-400 uppercase text-[11px] tracking-wider bg-slate-900/30">
                                        @L["Tools_Proficiencies"]
                                    </td>
                                    <td class="px-1 py-2.5 font-sans font-medium text-slate-300 text-right text-xs">
                                        @string.Join(", ", _fullClass.ToolProficiencies.Select(a => L[a.ToString()].Value))
                                    </td>
                                </tr>
                            }
                            <tr class="border-b border-slate-800/40 hover:bg-white/5 transition-colors">
                                <td class="px-3 py-2.5 font-bold text-slate-400 uppercase text-[11px] tracking-wider bg-slate-900/30">
                                    @L["Weapon_Proficiencies"]
                                </td>
                                <td class="px-3 py-2.5 font-sans font-medium text-slate-300 text-right text-xs">
                                    @string.Join(" / ", _fullClass.WeaponProficiencies.Select(a => L[a.ToString()].Value))
                                </td>
                            </tr>
                            <tr class="hover:bg-white/5 transition-colors">
                                <td class="px-3 py-2.5 font-bold text-slate-400 uppercase text-[11px] tracking-wider bg-slate-900/30">
                                    @L["Armor_Proficiencies"]
                                </td>
                                <td class="px-3 py-2.5 font-sans font-medium text-slate-300 text-right text-xs">
                                    @string.Join(" / ", _fullClass.ArmorProficiencies.Select(a => L[a.ToString()].Value))
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="flex-1 min-w-0 w-full">
                <p class="text-slate-400 font-sans text-sm leading-relaxed mt-3">
                    @((MarkupString)_fullClass.Description)
                </p>
            </div>
        </div>

        @if (_fullClass.Subclasses != null && _fullClass.Subclasses.Any())
        {
            <div class="animate-in fade-in duration-300">
                <div class="flex justify-between items-center mb-3">
                    <h3 class="text-amber-500 font-black text-xs tracking-[0.2em] uppercase flex items-center gap-2">
                        <i class="fa-solid fa-scroll"></i> @LL["Subclasses_Archetypes"]
                    </h3>
                    @if (SelectedSubclass != null)
                    {
                        <button @onclick="() => SelectedSubclass = null" class="text-[10px] uppercase tracking-wider font-mono text-red-400 hover:text-red-300 bg-red-950/20 border border-red-500/20 px-2 py-0.5 rounded-md transition-colors">
                            <i class="fa-solid fa-xmark"></i> @LL["Un_Select_Archetype"]
                        </button>
                    }
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                    @foreach (var subclass in _fullClass.Subclasses)
                    {
                        bool isSelected = SelectedSubclass?.Id == subclass.Id;
                        <div @onclick="() => ToggleSubclass(subclass)"
                             class="relative overflow-hidden p-4 rounded-xl border cursor-pointer shadow-md backdrop-blur-sm group transition-all duration-200
                            @(isSelected ? "border-amber-500 bg-amber-500/10 shadow-amber-500/5" : "border-slate-800 bg-black/30 hover:border-amber-500/30")">

                            <div class="absolute -right-3 -bottom-3 text-white/5 pointer-events-none transition-transform group-hover:scale-110 duration-300">
                                <i class="fa-solid fa-shield-halved text-5xl @(isSelected ? "text-amber-500/10" : "")"></i>
                            </div>

                            <div class="relative min-w-0">
                                <div class="flex items-center justify-between gap-2">
                                    <h4 class="text-sm font-black uppercase tracking-wide transition-colors @(isSelected ? "text-amber-400" : "text-slate-200 group-hover:text-amber-400")">
                                        @subclass.Name
                                    </h4>
                                    @if (isSelected)
                                    {
                                        <span class="text-[9px] font-mono font-black uppercase tracking-wider bg-amber-500 text-black px-1.5 py-0.5 rounded-md shrink-0">@LL["Active"]</span>
                                    }
                                </div>
                                <p class="text-[11px] text-slate-400 font-sans leading-relaxed mt-1 line-clamp-3">
                                    @((MarkupString)subclass.Description)
                                </p>
                            </div>
                        </div>
                    }
                </div>

                @if (SelectedSubclass != null)
                {
                    <div class="mt-4 p-4 bg-amber-500/5 rounded-2xl border border-amber-500/20 shadow-lg animate-in slide-in-from-top-2 duration-200">
                        <h5 class="text-xs font-black text-amber-400 uppercase tracking-widest flex items-center gap-1.5 font-mono">
                            <i class="fa-solid fa-circle-info"></i> @LL["Reading_Manuscript"] @SelectedSubclass.Name
                        </h5>
                        <p class="text-xs text-slate-300 font-sans leading-relaxed mt-2 italic">
                            @((MarkupString)SelectedSubclass.Description)
                        </p>
                    </div>
                }
            </div>
        }

        <div>
            <h3 class="text-amber-500 font-black text-xs tracking-[0.2em] uppercase mb-4 flex items-center gap-2">
                <i class="fa-solid fa-medal"></i>
                @(SelectedSubclass == null ? LL["Class_Progression"] : string.Format(LL["Progression_With_Subclass_Active"].Value, SelectedSubclass.Name))
            </h3>

            <div class="space-y-3 max-h-[50vh] overflow-y-auto pr-2 custom-scrollbar">
                @foreach (var prog in _fullClass.Progressions.OrderBy(p => p.Level))
                {

                    <div class="flex flex-col md:flex-row items-start gap-4 p-4 bg-black/30 rounded-2xl border border-white/5">
                        <div class="bg-amber-500 text-black font-black text-xs px-3 py-1 rounded-md shrink-0">
                            @L["Level"] @prog.Level
                        </div>
                        <!-- <div class="flex flex-wrap gap-1.5">
                            @foreach (var trait in prog.Traits)
                            {
                                <div class="bg-slate-900 border border-amber-500/30 text-slate-200 text-[10px] px-2.5 py-1 rounded-lg shadow-sm flex items-center gap-1.5">
                                    <span class="font-bold text-amber-400 uppercase tracking-wider">
                                        @L[$"TraitType_{trait.Type}"]
                                    </span>

                                    <span class="text-slate-600 font-bold">|</span>

                                    @if (trait.Type.ToString() == "SpellSlots")
                                    {
                                        <div class="overflow-x-auto custom-scrollbar max-w-[200px] sm:max-w-xs">
                                            <div class="flex items-center gap-1.5 font-mono text-amber-300 bg-amber-500/10 px-1.5 py-0.5 rounded border border-amber-500/20 whitespace-nowrap">
                                                @for (int i = 0; i < trait.SpellSlots.Length; i++)
                                                {
                                                    @if (i > 0)
                                                    {
                                                        <span class="text-amber-500/40">|</span>
                                                    }
                                                    <span class="flex items-baseline gap-0.5">
                                                        <span class="text-[8px] text-amber-400/60 font-sans">L@(i + 1)</span>
                                                        <span>@trait.SpellSlots[i]</span>
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="font-mono text-slate-300">
                                            @trait.Value
                                        </span>
                                    }
                                </div>
                            }

                         </div>-->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 w-full min-w-0">
                            @foreach (var feature in prog.Features)
                            {
                                if (SelectedSubclass != null && feature.Name == "Subclass Feature")
                                    continue;

                                var matchedFeature = _fullClass.FeatureDtos.FirstOrDefault(f => f.Id == feature.Id);
                                if (matchedFeature != null)
                                {
                                    <div @onclick="() => OpenFeatureModal(matchedFeature)"
                                         class="bg-white/5 p-3 rounded-xl border border-slate-800 flex flex-col justify-between min-w-0 cursor-pointer hover:bg-white/10 hover:border-amber-500/20 active:scale-[0.98] transition-all duration-150 shadow-sm">
                                        <h4 class="text-white font-bold text-sm uppercase truncate">@matchedFeature.Name</h4>
                                        <p class="text-[11px] text-slate-400 font-sans line-clamp-2 mt-1">
                                            @Formatter.Format(matchedFeature.Description, false)
                                        </p>
                                    </div>
                                }
                            }
                            @if (SelectedSubclass?.Progressions != null)
                            {
                                var subProg = SelectedSubclass.Progressions.FirstOrDefault(p => p.Level == prog.Level);
                                if (subProg?.Features != null)
                                {
                                    @foreach (var subFeature in subProg.Features)
                                    {
                                        var matchedSubFeature = SelectedSubclass.FeatureDtos.FirstOrDefault(f => f.Id == subFeature.Id);
                                        if (matchedSubFeature != null)
                                        {
                                            <div @onclick="() => OpenFeatureModal(matchedSubFeature)"
                                                 class="bg-amber-500/5 p-3 rounded-xl border border-amber-500/20 flex flex-col justify-between min-w-0 cursor-pointer hover:bg-amber-500/10 hover:border-amber-500/40 active:scale-[0.98] transition-all duration-150 animate-in zoom-in-95 shadow-sm">
                                                <div class="flex justify-between items-start gap-1">
                                                    <h4 class="text-amber-400 font-bold text-sm uppercase truncate">@matchedSubFeature.Name</h4>
                                                    <span class="text-[8px] font-mono bg-amber-500/20 border border-amber-500/30 px-1 rounded text-amber-400 shrink-0 uppercase">@SelectedSubclass.Name</span>
                                                </div>
                                                <p class="text-[11px] text-slate-300 font-sans line-clamp-2 mt-1">
                                                    @Formatter.Format(matchedSubFeature.Description, false)
                                                </p>
                                            </div>
                                        }
                                    }
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (ActiveFeatureForModal != null)
    {
        <div class="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 z-50 animate-in fade-in duration-200"
             @onclick="CloseFeatureModal">
            <div class="relative w-full max-w-lg rounded-2xl border border-slate-800 bg-slate-950 p-6 shadow-2xl shadow-amber-500/5 animate-in zoom-in-95 duration-200"
                 @onclick:stopPropagation>
                <div class="absolute size-48 bg-amber-500/5 rounded-full blur-3xl -top-10 -right-10 pointer-events-none"></div>
                <button @onclick="CloseFeatureModal"
                        class="absolute top-4 right-4 text-slate-500 hover:text-white transition-colors size-8 flex items-center justify-center rounded-lg hover:bg-white/5">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
                <div class="flex items-center gap-2 text-amber-500 font-mono text-[10px] uppercase tracking-[0.2em] mb-2">
                    <i class="fa-solid fa-book-sparkles"></i>
                    <span>@LL["Feature_Compendium"]</span>
                </div>
                <h3 class="text-xl font-black text-white uppercase italic tracking-wide border-b border-white/5 pb-3">
                    @ActiveFeatureForModal.Name
                </h3>
                <div class="mt-4 max-h-[50vh] overflow-y-auto pr-2 custom-scrollbar text-sm text-slate-300 font-sans leading-relaxed space-y-3">
                    @Formatter.Format(ActiveFeatureForModal.Description, false)

                    @if (!string.IsNullOrEmpty(ActiveFeatureForModal.Special))
                    {
                        <div class="mt-4 p-3 bg-white/5 rounded-xl border border-slate-800/60 font-sans text-xs text-slate-400">
                            <span class="font-bold text-amber-500 uppercase block mb-1">@LL["Special Notes"]:</span>
                            @ActiveFeatureForModal.Special
                        </div>
                    }
                </div>
                <div class="mt-6 flex justify-end">
                    <button @onclick="CloseFeatureModal"
                            class="px-4 py-2 rounded-xl bg-slate-900 border border-slate-800 hover:border-amber-500/30 font-medium text-xs uppercase tracking-wider text-slate-300 hover:text-white transition-all shadow-md">
                        @LL["Got_it"]
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public ClassDefinitionDto InspectedClass { get; set; } = null!;

    // 🚨 LA CLAVE: Estado interno privado para el DTO con relaciones completas
    private ClassDefinitionDto? _fullClass;
    private SubclassDto? SelectedSubclass;
    private FeatureDto? ActiveFeatureForModal;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "document.getElementById('main-scroll-view')?.scrollTo({ top: 0, behavior: 'instant' });");
        }
        catch { }
    }
    // 🚨 CAMBIADO: Usamos OnParametersSetAsync en lugar de OnInitializedAsync
    protected override async Task OnParametersSetAsync()
    {
        _fullClass = null; // Reinicia el cargador visual
        SelectedSubclass = null;
        ActiveFeatureForModal = null;

        if (InspectedClass != null)
        {
            // Dispara el query optimizado de SQLite usando la variable interna
            _fullClass = await ClassService.GetByIdAsync(InspectedClass.Id, config => config
                .Include(x => x.SkillProficiencies)
                .IncludeCollection(x => x.Progressions, u => u.Features)
                .IncludeCollection(x => x.Subclasses, sc => sc.Progressions, p => p.Features));
        }


    }

    private void CloseFeatureModal()
    {
        ActiveFeatureForModal = null;

    }
    private void OpenFeatureModal(FeatureDto feature) => ActiveFeatureForModal = feature;

    private void ToggleSubclass(SubclassDto subclass)
    {
        if (SelectedSubclass?.Id == subclass.Id)
            SelectedSubclass = null;
        else
            SelectedSubclass = subclass;
    }
}
@using RafeTale.Application.DTOs
@inject IStringLocalizer<AppStrings> L

<div class="bg-slate-900 border border-amber-900/20 rounded-2xl p-4 shadow-xl space-y-3">
    <div class="flex justify-between items-center border-b border-amber-900/10 pb-2.5">
        <h3 class="text-amber-500 font-black text-xs flex items-center gap-2 uppercase tracking-wider">
            <i class="fa-solid fa-list-check text-amber-700"></i> @L["Title_Skills"]
        </h3>
        <span class="text-[10px] font-mono font-black text-slate-400 bg-black/50 px-2 py-0.5 rounded-full border border-slate-800">
            @L["Label_Proficiency"]: +@CharDto.ProficiencyBonus
        </span>
    </div>
    <div class="space-y-1 max-h-[55vh] overflow-y-auto pr-1">
        @foreach (var skill in SkillMap.OrderBy(s => L[s.Key].Value))
        {
            <SkillRow SkillKey="@skill.Key"
                      Stat="@skill.Value"
                      Bonus="CharDto.GetSkillBonus(skill.Key, skill.Value, TrainedSkills)"
                      IsProficient="TrainedSkills.Contains(skill.Key)"
                      ShortStat="@ShortStatMap[skill.Value]" />
        }
    </div>
</div>

@code {
    [Parameter] public CharacterDto CharDto { get; set; } = null!;
    [Parameter] public List<string> TrainedSkills { get; set; } = [];

    private static readonly Dictionary<string, string> SkillMap = new()
    {
        { "Acrobatics", "Dexterity" }, { "Athletics", "Strength" }, { "Arcana", "Intelligence" },
        { "Deception", "Charisma" }, { "History", "Intelligence" }, { "Performance", "Charisma" },
        { "Intimidation", "Charisma" }, { "Investigation", "Intelligence" }, { "SleightOfHand", "Dexterity" },
        { "Medicine", "Wisdom" }, { "Nature", "Intelligence" }, { "Perception", "Wisdom" },
        { "Insight", "Wisdom" }, { "Persuasion", "Charisma" }, { "Religion", "Intelligence" },
        { "Stealth", "Dexterity" }, { "Survival", "Wisdom" }, { "AnimalHandling", "Wisdom" }
    };

    private static readonly Dictionary<string, string> ShortStatMap = new()
    {
        { "Strength", "STR" }, { "Dexterity", "DEX" }, { "Constitution", "CON" },
        { "Intelligence", "INT" }, { "Wisdom", "WIS" }, { "Charisma", "CHA" }
    };
}
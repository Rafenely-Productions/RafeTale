@page "/"
@inject NavigationManager Nav
@inject IStringLocalizer<AppStrings> L

<div class="h-full flex flex-col justify-between items-center px-1 py-6 text-slate-100 animate__animated animate__fadeIn overflow-hidden bg-slate-950">

    @if (isBetaExpired)
    {
        <div class="my-auto space-y-4 animate-in fade-in duration-500 text-center">
            <div class="size-20 bg-amber-500/10 border border-amber-500/30 rounded-full flex items-center justify-center mx-auto text-amber-500 text-3xl shadow-lg">
                <i class="fa-solid fa-door-closed"></i>
            </div>

            <h1 class="text-2xl font-black text-amber-500 italic uppercase tracking-wider">
                La Taberna Ha Cerrado Sus Puertas
            </h1>

            <p class="text-slate-400 font-serif italic text-sm leading-relaxed px-2">
                "El tiempo de prueba de esta aventura ha llegado a su ocaso. Las luces de la posada se han apagado para esta versión de prueba."
            </p>

            <div class="p-3 bg-black/40 rounded-2xl border border-slate-800 text-[11px] text-amber-400 font-mono inline-block">
                Beta Expirada: @expirationDate.ToString("dd/MM/yyyy")
            </div>
        </div>
    }
    else
    {
        <div class="text-center space-y-3 pt-2">
            <div class="size-28 mx-auto  flex items-center justify-center overflow-hidden">
                <img src="images/logo.svg" alt="Logo" />
            </div>

            <h1 class="text-3xl font-black text-amber-500 tracking-tighter italic uppercase mt-3">@L["AppName"]</h1>
            <p class="text-[9px] font-serif italic text-slate-400 tracking-widest uppercase">@L["AppSlogan"]</p>
        </div>

        <div class="w-full max-w-xs grid grid-cols-2 gap-3 pb-6 my-auto">

            <NavLink href="/characters" Match="NavLinkMatch.All"
                     class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-900 border border-amber-900/30 hover:border-amber-500/50 hover:bg-slate-800/80 transition-all shadow-lg group overflow-hidden">
                <div class="size-7 rounded-lg  text-amber-500 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-users text-xs"></i>
                </div>
                <span class="text-[10px] font-black uppercase tracking-wider text-slate-200 group-hover:text-amber-400 ">@L["NavCharacters"]</span>
            </NavLink>

            <NavLink href="/library"
                     class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-900 border border-amber-900/30 hover:border-amber-500/50 hover:bg-slate-800/80 transition-all shadow-lg group overflow-hidden">
                <div class="size-7 rounded-lg text-amber-500 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-book-atlas text-xs"></i>
                </div>
                <span class="text-[10px] font-black uppercase tracking-wider text-slate-200 group-hover:text-amber-400 ">@L["NavLibrary"]</span>
            </NavLink>

            <NavLink href="/character/create"
                     class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-900 border border-amber-900/30 hover:border-amber-500/50 hover:bg-slate-800/80 transition-all shadow-lg group overflow-hidden">
                <div class="size-7 rounded-lg text-amber-500 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-user-plus text-xs"></i>
                </div>
                <span class="text-[10px] font-black uppercase tracking-wider text-slate-200 group-hover:text-amber-400 ">@L["NavCreation"]</span>
            </NavLink>

            <NavLink href="/dice"
                     class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-900 border border-amber-900/30 hover:border-amber-500/50 hover:bg-slate-800/80 transition-all shadow-lg group overflow-hidden">
                <div class="size-7 rounded-lg text-amber-500 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                    <i class="fa-solid fa-dice-d20 text-xs"></i>
                </div>
                <span class="text-[10px] font-black uppercase tracking-wider text-slate-200 group-hover:text-amber-400 ">@L["NavDice"]</span>
            </NavLink>

        </div>

        
    }
</div>

@code {
    private bool isBetaExpired = false;

    private DateTime expirationDate = new DateTime(2026, 10, 7);

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(1000);

        if (DateTime.Now > expirationDate)
        {
            isBetaExpired = true;
        }
    }
}
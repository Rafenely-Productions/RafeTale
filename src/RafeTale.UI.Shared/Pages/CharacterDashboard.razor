@page "/character/{CharacterId:guid}"
@using RafeTale.Application.DTOs
@using RafeTale.Application.Interfaces
@using RafeTale.Application.Interfaces.DtosInterfaces
@using RafeTale.Domain.Entities
@using RafeTale.Domain.Enums
@using RafeTale.UI.Shared.Components.Character
@inject IService<CharacterDto, Character> CharacterService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject ILevelUpService LevelUpService

<div class="min-h-screen bg-black p-3 sm:p-5 text-slate-100 selection:bg-amber-500/30 pb-24">
    @if (CharDto == null)
    {
        <div class="flex flex-col items-center justify-center py-32">
            <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-amber-500 mb-4"></div>
            <p class="text-amber-500 italic font-serif text-sm">@L["Msg_SummoningHero"]</p>
        </div>
    }
    else
    {
        <div class="max-w-4xl mx-auto space-y-4">
            <CharacterHeader CharDto="CharDto"
                             AuditStatus="AuditStatus"
                             OnBack="Back"
                             OnLevelUp="NavigateToLevelUp"
                             OnClaimRewards="NavigateToClaimRewards"
                             OnOpenRaceCompendium="() => showRaceModal = true"
                             OnOpenClassCompendium="() => showClassModal = true" />

            <CharacterTabBar ActiveTab="activeTab" OnTabChanged="OnTabChanged" />

            <div class="space-y-4">
                @switch (activeTab)
                {
                    case CharacterTab.Spells:
                        <SpellTab CharDto="CharDto"
                                  OnInspectSpell="OpenSpellInspector"
                                  OnCharacterUpdated="StateHasChanged" />
                        break;
                    case CharacterTab.Skills:
                        <SkillsTab CharDto="CharDto" TrainedSkills="trainedSkills" />
                        break;
                    case CharacterTab.Features:
                        <FeaturesTab CharDto="CharDto" />
                        break;
                }
            </div>

            <RollDices />

            @if (showRaceModal && CharDto.Race != null)
            {
                <div class="fixed inset-0 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4 z-50" @onclick="() => showRaceModal = false">
                    <div class="relative w-full max-w-lg rounded-3xl border border-slate-800 bg-slate-950 p-6 shadow-2xl flex flex-col max-h-[80vh]" @onclick:stopPropagation>
                        <button @onclick="() => showRaceModal = false" class="absolute top-4 right-4 text-slate-500 hover:text-white size-8 flex items-center justify-center rounded-full bg-white/5 z-20">
                            <i class="fa-solid fa-xmark text-sm"></i>
                        </button>
                        <div class="overflow-y-auto pr-1 flex-1">
                            <@RaceInspector RaceDto="CharDto.Race" />
                        </div>
                    </div>
                </div>
            }

            @if (showClassModal && CharDto.ClassDef != null)
            {
                <div class="fixed inset-0 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4 z-50" @onclick="() => showClassModal = false">
                    <div class="relative w-full max-w-lg rounded-3xl border border-slate-800 bg-slate-950 p-6 shadow-2xl flex flex-col max-h-[80vh]" @onclick:stopPropagation>
                        <button @onclick="() => showClassModal = false" class="absolute top-4 right-4 text-slate-500 hover:text-white size-8 flex items-center justify-center rounded-full bg-white/5 z-20">
                            <i class="fa-solid fa-xmark text-sm"></i>
                        </button>
                        <div class="overflow-y-auto pr-1 flex-1">
                            <@ClassInspector InspectedClass="CharDto.ClassDef" />
                        </div>
                    </div>
                </div>
            }

            <SpellModal Spell="selectedSpellForModal" OnClose="CloseSpellModal" />
        </div>
    }
</div>

@code {
    [Parameter] public Guid CharacterId { get; set; }
    private CharacterDto? CharDto;
    private CharacterAuditDto? AuditStatus;

    private CharacterTab activeTab = CharacterTab.Spells;
    private bool showRaceModal = false;
    private bool showClassModal = false;
    private SpellDto? selectedSpellForModal;
    private List<string> trainedSkills = new();

    protected override async Task OnInitializedAsync()
    {
        CharDto = await CharacterService.GetByIdAsync(CharacterId, q => q.Include(x => x.KnownSpells).Include(x => x.SpellSlots));
        AuditStatus = await LevelUpService.AuditCharacterAsync(CharacterId);

        if (CharDto?.ClassDef?.SkillProficiencies != null)
        {
            trainedSkills = CharDto.ClassDef.SkillProficiencies;
        }
    }

    private void OnTabChanged(CharacterTab tab) => activeTab = tab;

    private void OpenSpellInspector(SpellDto spell) { selectedSpellForModal = spell; }
    private void CloseSpellModal() => selectedSpellForModal = null;

    private void NavigateToLevelUp() => Navigation.NavigateTo($"/character/{CharDto?.Id}/levelup");
    private void Back() => Navigation.NavigateTo("/characters");
    private void NavigateToClaimRewards() => Navigation.NavigateTo($"/character/{CharDto?.Id}/levelup?mode=claim");
}
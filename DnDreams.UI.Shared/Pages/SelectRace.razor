@page "/character/create/race"
@using DnDreams.Domain.Entities
@using DnDreams.Domain.Interfaces
@using DnDreams.Domain.DTOs
@inject IUnitOfWork UnitOfWork
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject CharacterCreationService CreationService

<div class="min-h-screen bg-black p-6">
    <div class="max-w-6xl mx-auto">

        <div class="mb-8">
            <button @onclick='Back' class="text-amber-700 hover:text-amber-500 text-[10px] font-black tracking-[0.3em] mb-4 uppercase flex items-center gap-2 transition-all">
                <i class="fa-solid fa-arrow-left"></i> @L["Btn_Back"]
            </button>
            <h1 class="text-5xl font-black text-amber-500 italic uppercase tracking-tighter">@L["Title_SelectRace"]</h1>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

            <div class="lg:col-span-4 space-y-3">
                @foreach (var race in Races)
                {
                    <div @onclick="() => SelectedRace = race"
                         class="group cursor-pointer p-6 rounded-2xl border transition-all duration-300 @(SelectedRace?.Id == race.Id ? "bg-amber-600 border-amber-400 shadow-[0_0_20px_rgba(245,158,11,0.3)]" : "bg-slate-900 border-amber-900/20 hover:border-amber-500/50")">
                        <div class="flex justify-between items-center">
                            <span class="text-xl font-black uppercase tracking-tight @(SelectedRace?.Id == race.Id ? "text-black" : "text-white group-hover:text-amber-500")">
                                @race.Name
                            </span>
                            <i class="fa-solid fa-chevron-right @(SelectedRace?.Id == race.Id ? "text-black" : "text-amber-900/40")"></i>
                        </div>
                    </div>
                }
            </div>

            <div class="lg:col-span-8">
                <div class="bg-slate-900 border border-amber-900/30 rounded-[3rem] p-10 shadow-2xl min-h-[600px] relative overflow-hidden">

                    @if (SelectedRace == null)
                    {
                        <div class="flex flex-col items-center justify-center h-full py-20 text-center">
                            <i class="fa-solid fa-scroll text-amber-900/10 text-[10rem] mb-6"></i>
                            <p class="text-amber-700 font-serif italic text-xl">@L["Msg_SelectRacePrompt"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="animate-in fade-in duration-500">
                            <div class="flex flex-wrap justify-between items-start gap-6 mb-8">
                                <div class="flex-1">
                                    <h2 class="text-6xl font-black text-white mb-2 uppercase italic tracking-tighter">@SelectedRace.Name</h2>
                                    <p class="text-slate-400 font-serif italic text-lg">@SelectedRace.Description</p>
                                </div>

                                <div class="flex gap-4">
                                    <div class="bg-amber-600/10 border border-amber-600/30 p-4 rounded-3xl text-center min-w-[90px]">
                                        <span class="block text-[10px] font-black text-amber-600 uppercase mb-1">@L["Label_Speed"]</span>
                                        <span class="text-2xl font-black text-white">@SelectedRace.Speed <small class="text-xs uppercase">@L["Unit_Feet"]</small></span>
                                    </div>
                                    <div class="bg-amber-600/10 border border-amber-600/30 p-4 rounded-3xl text-center min-w-[90px]">
                                        <span class="block text-[10px] font-black text-amber-600 uppercase mb-1">@L["Label_Size"]</span>
                                        <span class="text-2xl font-black text-white">@SelectedRace.Size</span>
                                    </div>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                                <div class="space-y-8">
                                    <div>
                                        <h3 class="text-amber-500 font-black text-xs tracking-[0.3em] uppercase mb-4 flex items-center gap-2">
                                            <i class="fa-solid fa-dna text-amber-700"></i> @L["Label_Traits"]
                                        </h3>
                                        <div class="space-y-3">
                                            @* Aquí iteramos los rasgos que vienen de la DB *@
                                            @foreach (var trait in SelectedRace.Traits)
                                            {
                                                <div class="group bg-black/20 p-5 rounded-3xl border border-white/5 hover:border-amber-500/30 transition-colors">
                                                    <h4 class="text-amber-500 font-bold text-sm uppercase mb-1">@trait.Name</h4>
                                                    <p class="text-slate-400 text-xs leading-relaxed">@trait.Description</p>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="space-y-8">
                                    <div>
                                        <h3 class="text-amber-500 font-black text-xs tracking-[0.3em] uppercase mb-4 flex items-center gap-2">
                                            <i class="fa-solid fa-bolt text-amber-700"></i> @L["Label_RaceAbilities"]
                                        </h3>
                                        <div class="flex flex-wrap gap-2">
                                            @* Ejemplo de visualización de bonos *@
                                            <div class="bg-lime-600/20 border border-lime-600/30 px-4 py-2 rounded-xl">
                                                <span class="text-lime-500 font-black text-lg">+2 @L["Stat_Str"]</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div>
                                        <h3 class="text-amber-500 font-black text-xs tracking-[0.3em] uppercase mb-4 flex items-center gap-2">
                                            <i class="fa-solid fa-comment text-amber-700"></i> @L["Label_Languages"]
                                        </h3>
                                        <p class="text-slate-400 text-sm font-serif italic">
                                            @* Aquí irían los idiomas separados por coma *@
                                            Común, Elfo, Enano.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-12 pt-8 border-t border-white/5 flex justify-end">
                                <button @onclick="Confirm"
                                        class="group px-12 py-5 bg-amber-600 hover:bg-amber-500 text-black font-black rounded-[2rem] transition-all shadow-xl shadow-amber-900/20 flex items-center gap-4">
                                    <span class="uppercase tracking-widest">@L["Btn_ConfirmRace"]</span>
                                    <i class="fa-solid fa-arrow-right group-hover:translate-x-2 transition-transform"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private List<Race> Races = new();
    private Race? SelectedRace;

    protected override async Task OnInitializedAsync()
    {
        Races = (await UnitOfWork.Races.GetAllAsync()).ToList();
    }

    private void Back() => Navigation.NavigateTo("/character/create");

    private void Confirm()
    {
        if (SelectedRace != null)
        {
            CreationService.SelectedRaceId = SelectedRace.Id;
            Navigation.NavigateTo("/character/create");
        }
    }
}
@page "/character/{CharacterId:guid}/levelup"
@using DnDreams.Application.DTOs
@using DnDreams.Application.Interfaces
@using DnDreams.Application.Interfaces.DtosInterfaces
@using DnDreams.Domain.Entities
@using DnDreams.UI.Shared.Components.LevelUp
@inject ILevelUpService LevelUpService
@inject IService<CharacterDto, Character> CharacterService
@inject IService<FeatDto, Feat> FeatService
@inject IService<SpellDto, Spell> SpellService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L

<div class="min-h-screen bg-black p-4 md:p-6 text-slate-100 selection:bg-amber-500/30 pb-24">
    <div class="max-w-4xl mx-auto space-y-6">

        @if (charDto == null || draft == null || draft.SpellBudget == null)
        {
            <div class="flex flex-col items-center justify-center py-32">
                <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-amber-500 mb-4"></div>
                <p class="text-amber-500 italic font-serif text-sm">@L["Msg_LoadingProgression"]</p>
            </div>
        }
        else
        {
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 border-b border-white/5 pb-4">
                <div>
                    <button @onclick="Cancel" class="text-slate-500 hover:text-slate-300 text-[10px] font-black tracking-widest mb-2 uppercase flex items-center gap-2 transition-colors">
                        <i class="fa-solid fa-xmark"></i> @L["Btn_Cancel"]
                    </button>
                    <h1 class="text-2xl sm:text-3xl font-black text-amber-500 italic uppercase tracking-tighter">
                        @(Mode == "claim" ? L["Title_ClaimPendingRewards"] : L["Title_LevelUp"]): @charDto.Name
                    </h1>
                    <p class="text-xs text-slate-400 font-sans mt-0.5">
                        @if (Mode == "claim")
                        {
                            <span class="text-amber-400 font-bold">@L["Label_AuditingLevel"] @charDto.Level</span>
                        }
                        else
                        {
                            @L["Label_CurrentLevel"] <span class="text-white font-bold">@charDto.Level</span>
                            <span> → @L["Label_NextLevel"] </span><span class="text-amber-400 font-black">@draft.TargetLevel</span>
                        }
                    </p>
                </div>
            </div>

            <LevelUpStepper Draft="draft" CurrentStep="currentStep" Mode="Mode" OnStepSelected="SetStep" />

            <div class="bg-slate-900 border border-amber-900/20 rounded-3xl p-5 sm:p-8 shadow-2xl min-h-[350px] flex flex-col justify-between">

                @if (currentStep == 1)
                {
                    <HpSelectionStep CharDto="charDto" Draft="draft" AverageHpBase="averageHpBase" />
                }
                else if (currentStep == 2)
                {
                    <FeatAsiSelectionStep Draft="draft" AvailableFeats="availableFeats" />
                }
                else if (currentStep == 3)
                {
                    <SpellSelectionStep CharDto="charDto" Draft="draft" AvailableSpells="availableSpells" />
                }

                <div class="grid grid-cols-2 items-center border-t border-white/5 pt-3 mt-4 shrink-0 gap-3">
                    <div class="flex justify-start">
                        <button disabled="@(currentStep == 1 || (Mode == "claim" && currentStep == 2))" @onclick="PrevStep" class="px-3 py-1.5 rounded-lg border border-slate-800 bg-slate-950 text-slate-400 hover:text-white text-[10px] font-black uppercase tracking-wider transition-all disabled:opacity-0">
                            <i class="fa-solid fa-angle-left mr-1"></i> @L["Btn_StepBack"]
                        </button>
                    </div>

                    <div class="flex justify-end">
                        @if (IsOnLastStep())
                        {
                            <button @onclick="SubmitLevelUp" class="px-4 py-2 bg-gradient-to-r from-lime-600 to-lime-500 hover:from-lime-500 hover:to-lime-400 text-black font-black rounded-lg text-[10px] uppercase tracking-wider transition-all shadow-md flex items-center gap-1.5 truncate">
                                <span class="truncate">@L["Btn_ConfirmLevelUp"]</span> <i class="fa-solid fa-fire shrink-0"></i>
                            </button>
                        }
                        else
                        {
                            <button @onclick="NextStep" class="px-4 py-1.5 bg-amber-500 hover:bg-amber-400 text-black font-black rounded-lg text-[10px] uppercase tracking-wider transition-all shadow flex items-center gap-1.5">
                                <span class="truncate">@L["Btn_NextStep"]</span> <i class="fa-solid fa-angle-right shrink-0"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid CharacterId { get; set; }
    [SupplyParameterFromQuery(Name = "mode")] public string? Mode { get; set; }

    private CharacterDto? charDto;
    private LevelUpDraft? draft;
    private int currentStep = 1;
    private int averageHpBase;
    private List<FeatDto> availableFeats = new();
    private List<SpellDto> availableSpells = new();

    protected override async Task OnInitializedAsync()
    {
        charDto = await CharacterService.GetByIdAsync(CharacterId);
        if (charDto != null)
        {
            if (Mode == "claim")
            {
                draft = await LevelUpService.PrepareClaimDraftAsync(CharacterId);
                currentStep = draft.GivesFeat ? 2 : 3; 
            }
            else
            {
                draft = await LevelUpService.PrepareLevelUpAsync(CharacterId);
                currentStep = 1;
            }

            int hitDie = charDto.ClassDef?.HitDieValue ?? 8;
            averageHpBase = (hitDie / 2) + 1;

            if (Mode != "claim")
            {
                draft.HpGain = averageHpBase + charDto.ConModifier;
            }

            if (draft.GivesFeat)
            {
                availableFeats = await FeatService.GetAllAsync(null, null);
            }

            var allSpells = await SpellService.GetAllAsync(null);
            if (allSpells != null && charDto.ClassDef != null && draft.SpellBudget != null)
            {
               availableSpells = allSpells
                    .Where(s => s.ClassesTechnicalNames.Contains(charDto.ClassDef.TechnicalName, StringComparer.OrdinalIgnoreCase) &&
                        ((int)s.Level == 0 || (int)s.Level <= draft.SpellBudget.MaxSpellLevel))
                    .OrderBy(s => s.Level)
                    .ThenBy(s => s.Name)
                    .ToList();
            }
        }
    }

    private void SetStep(int step)
    {
        if (Mode == "claim" && step == 1) return;
        if (step == 2 && !draft!.GivesFeat) return;
        if (step == 3 && draft!.SpellsToLearnCount == 0 && Mode != "claim") return;
        currentStep = step;
    }

    private void NextStep()
    {
        if (currentStep == 1 && draft!.GivesFeat) currentStep = 2;
        else if (currentStep <= 2 && (draft!.SpellsToLearnCount > 0 || Mode == "claim")) currentStep = 3;
    }

    private void PrevStep()
    {
        if (currentStep == 3 && draft!.GivesFeat) currentStep = 2;
        else if (currentStep >= 2 && Mode != "claim") currentStep = 1;
    }

    private bool IsOnLastStep()
    {
        if ((draft!.SpellsToLearnCount > 0 || Mode == "claim") && currentStep == 3) return true;
        if (draft.SpellsToLearnCount == 0 && draft.GivesFeat && currentStep == 2) return true;
        if (!draft.GivesFeat && draft.SpellsToLearnCount == 0 && currentStep == 1) return true;
        return false;
    }

    private void Cancel() => Navigation.NavigateTo($"/character/{CharacterId}");

    private async Task SubmitLevelUp()
    {
        if (draft == null) return;
        await LevelUpService.CommitLevelUpAsync(draft);
        Navigation.NavigateTo($"/character/{CharacterId}", forceLoad: true);
    }
}
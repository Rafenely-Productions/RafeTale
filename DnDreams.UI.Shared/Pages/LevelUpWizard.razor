@page "/character/{CharacterId:guid}/levelup"
@using DnDreams.Domain.Entities
@using DnDreams.Application.Interfaces
@using DnDreams.Application.Models
@using DnDreams.UI.Shared.Components.LevelUp
@inject ILevelingService LevelingService
@inject IUnitOfWork UnitOfWork
@inject NavigationManager Navigation

<div class="min-h-screen bg-black p-6">
    <div class="container mx-auto max-w-4xl">
        @if (CurrentCharacter == null)
        {
            <div class="flex flex-col justify-center items-center h-96">
                <div class="animate-spin rounded-full h-16 w-16 border-t-4 border-b-4 border-amber-500 mb-4"></div>
                <p class="text-amber-500 italic font-serif animate-pulse">Consultando los archivos del destino...</p>
            </div>
        }
        else
        {
            <div class="bg-slate-900 border border-amber-900/30 rounded-[2rem] p-8 mb-8 shadow-[0_0_50px_rgba(0,0,0,0.8)] relative overflow-hidden">
                <div class="absolute top-0 right-0 p-4 opacity-5">
                    <i class="fa-solid fa-dice-d20 text-8xl text-white"></i>
                </div>

                <div class="flex flex-col md:flex-row justify-between items-center gap-6 relative z-10">
                    <div class="text-center md:text-left">
                        <h1 class="text-4xl font-black text-amber-500 tracking-tight mb-2 italic uppercase">Subida de Nivel</h1>
                        <div class="flex items-center gap-3 justify-center md:justify-start">
                            <span class="text-white font-bold text-xl">@CurrentCharacter.Name</span>
                            <span class="bg-black/50 text-amber-600 px-3 py-1 rounded-full text-xs font-black border border-amber-900/40">
                                CurrentCharacter.ClassDef?.Name.ToUpper()
                            </span>
                        </div>
                        <p class="text-slate-500 mt-2 font-bold">
                            Nivel @CurrentCharacter.Level <i class="fa-solid fa-arrow-right mx-2 text-lime-500"></i> <span class="text-white text-lg">@(CurrentCharacter.Level + 1)</span>
                        </p>
                    </div>

                    <div class="flex flex-col items-center md:items-end gap-3">
                        <div class="text-[10px] font-black text-amber-700 uppercase tracking-[0.2em]">Paso de Senda</div>
                        <div class="flex gap-3">
                            @for (int i = 1; i <= 3; i++)
                            {
                                <div class="group relative">
                                    <div class="h-3 w-16 rounded-full transition-all duration-700 @(i <= CurrentStep ? "bg-amber-500 shadow-[0_0_15px_rgba(245,158,11,0.4)]" : "bg-black/40 border border-amber-900/20")"></div>
                                    @if (i == CurrentStep)
                                    {
                                        <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 text-[9px] font-black text-amber-500 whitespace-nowrap tracking-tighter">
                                            @GetStepName(i)
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-slate-900 border border-amber-900/20 rounded-[2.5rem] p-10 min-h-[550px] shadow-2xl relative">
                <div class="transition-all duration-500 ease-in-out">
                    @switch (CurrentStep)
                    {
                        case 1:
                            <div class="animate-in fade-in slide-in-from-right-4 duration-500">
                                <ASIFeatStep State="WizardState" />
                            </div>
                            break;
                        case 2:
                            <div class="animate-in fade-in slide-in-from-right-4 duration-500">
                                <SpellStep State="WizardState" Character="CurrentCharacter" />
                            </div>
                            break;
                        case 3:
                            <div class="animate-in fade-in slide-in-from-right-4 duration-500">
                                <HPStep State="WizardState" Character="CurrentCharacter" />
                            </div>
                            break;
                    }
                </div>
            </div>

            <div class="flex justify-between items-center mt-10">
                <button @onclick="PreviousStep"
                        disabled="@(CurrentStep == 1 || IsProcessing)"
                        class="px-8 py-4 bg-black border border-amber-900/40 text-amber-500 font-bold rounded-2xl transition-all disabled:opacity-10 flex items-center gap-2 hover:bg-amber-900/20">
                    <i class="fa-solid fa-chevron-left"></i> Atrás
                </button>

                <div class="flex gap-4 items-center">
                    <button @onclick="CancelLevelUp"
                            class="px-6 py-4 text-slate-500 hover:text-red-400 font-bold transition-colors uppercase text-xs tracking-widest">
                        Cancelar
                    </button>

                    @if (CurrentStep < 3)
                    {
                        <button @onclick="NextStep"
                                class="px-12 py-4 bg-amber-600 hover:bg-amber-500 text-black font-black rounded-2xl transition-all shadow-xl shadow-amber-900/20 flex items-center gap-2">
                            SIGUIENTE <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    }
                    else
                    {
                        <button @onclick="HandleFinish"
                                disabled="@(IsProcessing || !IsStepValid())"
                                class="px-12 py-4 bg-lime-600 text-black font-black rounded-2xl transition-all shadow-xl hover:bg-lime-500 disabled:bg-slate-800 disabled:text-slate-600 group">
                            @if (IsProcessing)
                            {
                                <i class="fa-solid fa-spinner animate-spin"></i>
                            }
                            else
                            {
                                <span class="flex items-center gap-2">
                                    FORJAR DESTINO <i class="fa-solid fa-wand-magic-sparkles text-black"></i>
                                </span>
                            }
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid CharacterId { get; set; }

    private Character? CurrentCharacter;
    private LevelUpState WizardState = new();
    private int CurrentStep = 1;
    private bool IsProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        CurrentCharacter = await UnitOfWork.Characters.GetByIdAsync(CharacterId);
        if (CurrentCharacter == null) Navigation.NavigateTo("/characters");
    }

    private string GetStepName(int step) => step switch
    {
        1 => "ATRIBUTOS / DOTES",
        2 => "CONJUROS",
        3 => "PUNTOS DE GOLPE",
        _ => ""
    };

    private void NextStep() => CurrentStep++;
    private void PreviousStep() => CurrentStep--;
    private void CancelLevelUp() => Navigation.NavigateTo("/characters");

    private bool IsStepValid()
    {
        if (CurrentStep == 3 && WizardState.SelectedHp <= 0) return false;
        return true;
    }

    private async Task HandleFinish()
    {
        if (IsProcessing) return;
        IsProcessing = true;

        try
        {
            var finalModifiers = WizardState.GetModifiersFromAsi();
            var success = await LevelingService.CommitLevelUpAsync(
                CharacterId,
                WizardState.SelectedHp,
                finalModifiers,
                WizardState.SelectedFeatId.HasValue ? new List<Guid> { WizardState.SelectedFeatId.Value } : new List<Guid>(),
                WizardState.SelectedSpellIds
            );

            if (success)
            {
                await Task.Delay(500);
                Navigation.NavigateTo($"/characters");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[LevelUp Error]: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
        }
    }
}
@page "/"
@inject NavigationManager Nav

<div class="min-h-[85vh] flex flex-col justify-between items-center p-6 text-slate-100 animate__animated animate__fadeIn">

    <div class="my-auto text-center space-y-4">
        <div class="size-28 mx-auto rounded-3xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center shadow-2xl shadow-amber-500/10 p-4">
            <img src="images/logo.svg" alt="Logo" class="w-full h-full object-contain filter drop-shadow-[0_0_10px_rgba(245,158,11,0.3)]" />
        </div>

        <h1 class="text-4xl font-black text-amber-500 tracking-tighter italic uppercase mt-4">DnDreams</h1>
        <p class="text-xs font-serif italic text-slate-400 tracking-widest uppercase">Escribe tu propia leyenda</p>
    </div>

    <div class="w-full grid grid-cols-2 gap-4 mt-8 pb-4">

        <NavLink href="/characters" Match="NavLinkMatch.All"
                 class="flex flex-col items-center justify-center gap-2 p-5 rounded-2xl bg-slate-900 border border-amber-900/30 hover:border-amber-500/50 hover:bg-slate-800/80 transition-all shadow-xl group">
            <div class="size-12 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center group-hover:scale-110 transition-transform">
                <i class="fa-solid fa-users text-xl"></i>
            </div>
            <span class="text-xs font-black uppercase tracking-wider text-slate-200 group-hover:text-amber-400">Personajes</span>
        </NavLink>

        <NavLink href="/library"
                 class="flex flex-col items-center justify-center gap-2 p-5 rounded-2xl bg-slate-900 border border-amber-900/30 hover:border-amber-500/50 hover:bg-slate-800/80 transition-all shadow-xl group">
            <div class="size-12 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center group-hover:scale-110 transition-transform">
                <i class="fa-solid fa-book-atlas text-xl"></i>
            </div>
            <span class="text-xs font-black uppercase tracking-wider text-slate-200 group-hover:text-amber-400">Librería</span>
        </NavLink>
        <NavLink href="/character/create"
                 class="flex flex-col items-center justify-center gap-2 p-5 rounded-2xl bg-slate-900 border border-amber-900/30 hover:border-amber-500/50 hover:bg-slate-800/80 transition-all shadow-xl group">
            <div class="size-12 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center group-hover:scale-110 transition-transform">
                <i class="fa-solid fa-book-atlas text-xl"></i>
            </div>
            <span class="text-xs font-black uppercase tracking-wider text-slate-200 group-hover:text-amber-400">Creacion</span>
        </NavLink>
    </div>

</div>
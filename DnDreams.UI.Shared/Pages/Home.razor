@page "/"
@inject NavigationManager Nav

<div class="home-container animate__animated animate__fadeIn">
    <header class="hero-section text-center">
        <div class="logo-circle">
            <img src="images/logo.svg" alt="Logo" class="hero-logo" />
        </div>
        <h1 class="dnd-title">DnDreams</h1>
        <p class="dnd-motto">Escribe tu propia leyenda</p>
    </header>

    <div class="actions-grid mt-5">
        <div class="action-card main" @onclick='() => Nav.NavigateTo("/characters")'>
            <div class="card-content">
                <i class="bi bi-person-badge-fill"></i>
                <h3>Mis Personajes</h3>
                <p>Gestiona tus héroes y sube de nivel.</p>
            </div>
            <div class="card-badge">Explorar</div>
        </div>

        <div class="secondary-actions">
            <div class="action-card" @onclick='() => Nav.NavigateTo("/campaigns")'>
                <i class="bi bi-journal-bookmark-fill"></i>
                <div>
                    <h4>Campañas</h4>
                    <p>Mesas de juego activas.</p>
                </div>
            </div>

            <div class="action-card" @onclick='() => Nav.NavigateTo("/sandbox")'>
                <i class="bi bi-file-earmark-excel"></i>
                <div>
                    <h4>Importar</h4>
                    <p>Traer datos desde Excel.</p>
                </div>
            </div>
        </div>
    </div>

    <footer class="home-footer">
        <div class="footer-divider"></div>
        <p><i class="bi bi-dice-2 me-2"></i> Listo para la próxima sesión</p>
    </footer>
</div>
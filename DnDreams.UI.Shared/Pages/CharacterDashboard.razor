@page "/character/{CharacterId:guid}"
@using DnDreams.Application.DTOs
@using DnDreams.Application.Interfaces.DtosInterfaces
@using DnDreams.Domain.Entities
@inject IService<CharacterDto, Character> CharacterService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject ISpellServiceSystem SpellService
@inject ILevelUpService LevelUpService

<div class="min-h-screen bg-black p-4 text-slate-100 selection:bg-amber-500/30 pb-24">
    @if (CharDto == null)
    {
        <div class="flex flex-col items-center justify-center py-32">
            <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-amber-500 mb-4"></div>
            <p class="text-amber-500 italic font-serif text-sm">@L["Msg_SummoningHero"]</p>
        </div>
    }
    else
    {
        <div class="max-w-4xl mx-auto space-y-6">

            <button @onclick="Back"
                    class="flex items-center gap-2 text-amber-800 hover:text-amber-500 font-black text-[10px] tracking-[0.2em] transition-colors group uppercase pt-2">
                <i class="fa-solid fa-arrow-left transition-transform group-hover:-translate-x-1"></i>
                @L["Btn_ReturnToTavern"]
            </button>

            @if (AuditStatus != null && AuditStatus.HasPendingChoices)
            {
                <div class="bg-amber-500/5 border border-amber-500/20 p-4 rounded-2xl flex flex-col gap-3 shadow-lg">
                    <div class="flex items-center gap-3 text-xs">
                        <div class="size-8 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-sparkles text-sm animate-pulse"></i>
                        </div>
                        <div>
                            <p class="font-black text-amber-500 uppercase tracking-wider text-sm">@L["Title_PendingSelections"]</p>
                            <p class="text-slate-400 mt-0.5 text-xs">
                                @if (AuditStatus.PendingFeats > 0)
                                {
                                    <span>@L["Msg_PendingFeats", AuditStatus.PendingFeats] </span>
                                }
                                @if (AuditStatus.PendingSpells > 0)
                                {
                                    <span>@L["Msg_PendingSpells", AuditStatus.PendingSpells]</span>
                                }
                            </p>
                        </div>
                    </div>
                    <button @onclick="NavigateToClaimRewards" class="w-full py-2.5 bg-amber-500 hover:bg-amber-400 text-black font-black text-xs rounded-xl uppercase tracking-widest shadow-md transition-all active:scale-[0.98]">
                        @L["Btn_ClaimSelections"]
                    </button>
                </div>
            }

            <div class="relative bg-slate-950/50 border border-amber-900/10 p-5 rounded-3xl shadow-inner space-y-4">

                <div class="flex justify-between items-start gap-3">
                    <h1 class="text-3xl font-black text-amber-500 tracking-tight italic uppercase truncate leading-none pt-1">@CharDto.Name</h1>
                    <span class="bg-amber-500 text-black px-3 py-1 rounded-xl text-xs font-black uppercase font-mono tracking-wider shrink-0 shadow-md">
                        Lvl @CharDto.Level
                    </span>
                </div>

                <div class="flex flex-wrap items-center gap-2.5 text-xs border-t border-slate-800/50 pt-3">
                    <div class="inline-flex items-center rounded-full bg-black/30 border border-slate-800 p-1 pl-3 pr-1.5 gap-2">
                        <span class="text-slate-300 font-serif italic text-xs">@CharDto.Race?.Name</span>
                        <button @onclick="OpenRaceCompendium" class="size-5 rounded-full bg-amber-500/5 text-amber-500 hover:bg-amber-500 hover:text-black transition-all flex items-center justify-center">
                            <i class="fa-solid fa-book-atlas text-[10px]"></i>
                        </button>
                    </div>

                    <div class="inline-flex items-center rounded-full bg-black/30 border border-slate-800 p-1 pl-3 pr-1.5 gap-2">
                        <span class="text-amber-400 font-black uppercase tracking-wide text-[11px]">@CharDto.ClassDef?.Name</span>
                        <button @onclick="OpenClassCompendium" class="size-5 rounded-full bg-amber-500/5 text-amber-500 hover:bg-amber-500 hover:text-black transition-all flex items-center justify-center">
                            <i class="fa-solid fa-book-atlas text-[10px]"></i>
                        </button>
                    </div>

                    <button @onclick="NavigateToLevelUp"
                            class="ml-auto group bg-lime-900/40 hover:bg-lime-600 text-lime-300 hover:text-black px-3.5 py-1.5 rounded-full font-bold text-[11px] uppercase tracking-wider transition-all flex items-center gap-1.5 border border-lime-500/20">
                        @L["Btn_LevelUp"] <i class="fa-solid fa-arrow-up group-hover:-translate-y-0.5 transition-transform text-[9px]"></i>
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-3 md:grid-cols-6 gap-2.5 px-1">
                @DisplayAttributeMinimalist("STR", CharDto.StrModifier)
                @DisplayAttributeMinimalist("DEX", CharDto.DexModifier)
                @DisplayAttributeMinimalist("CON", CharDto.ConModifier)
                @DisplayAttributeMinimalist("INT", CharDto.IntModifier)
                @DisplayAttributeMinimalist("WIS", CharDto.WisModifier)
                @DisplayAttributeMinimalist("CHA", CharDto.ChaModifier)
            </div>

            <div class="space-y-6">

                @if (CharDto.SpellSlots != null && CharDto.SpellSlots.Any())
                {
                    <div class="bg-slate-900 border border-amber-900/20 rounded-3xl p-5 shadow-xl space-y-4">
                        <div class="flex justify-between items-center border-b border-amber-900/10 pb-3">
                            <h3 class="text-amber-500 font-black text-xs uppercase tracking-wider flex items-center gap-2">
                                <i class="fa-solid fa-wand-sparkles text-amber-700"></i> @L["Title_SpellSlots"]
                            </h3>
                            <button @onclick="TriggerLongRest" class="px-2.5 py-1 text-[10px] font-black bg-amber-500/5 text-amber-500 hover:bg-amber-500 hover:text-black border border-amber-500/10 rounded-xl transition-all uppercase tracking-wider flex items-center gap-1">
                                <i class="fa-solid fa-bed text-xs"></i> Long Rest
                            </button>
                        </div>

                        <div class="space-y-3">
                            @foreach (var slot in CharDto.SpellSlots.Where(s => s.Level > 0).OrderBy(s => s.Level))
                            {
                                <div class="bg-black/30 border border-slate-800/80 p-3 rounded-2xl flex flex-col gap-2">
                                    <div class="flex justify-between items-center text-xs">
                                        <span class="font-bold text-slate-200">@L["Label_SlotLevel"] @slot.Level</span>
                                        <span class="font-mono text-[11px] text-amber-400 font-black bg-black/50 px-2 py-0.5 rounded">@slot.RemainingSlots / @slot.MaxSlots</span>
                                    </div>

                                    <div class="flex flex-wrap gap-1.5">
                                        @for (int i = 0; i < slot.MaxSlots; i++)
                                        {
                                            var currentPipIndex = i;
                                            bool isUsed = currentPipIndex < slot.UsedSlots;
                                            <div class="size-3.5 rounded-full border @(isUsed ? "bg-slate-950 border-slate-700" : "bg-cyan-400 border-cyan-300 shadow-[0_0_8px_rgba(34,211,238,0.5)]")"></div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="bg-slate-900 border border-amber-900/20 rounded-3xl p-5 shadow-xl space-y-4">
                    <h3 class="text-amber-500 font-black text-xs uppercase tracking-wider flex items-center gap-2 border-b border-amber-900/10 pb-3">
                        <i class="fa-solid fa-book-sparkles text-amber-700"></i> @L["Title_Spellbook"]
                    </h3>
                    <div class="space-y-2.5 max-h-[350px] overflow-y-auto pr-1">
                        @if (CharDto.KnownSpells == null || !CharDto.KnownSpells.Any())
                        {
                            <p class="text-slate-600 italic text-xs font-serif p-4 text-center bg-black/20 rounded-xl">Tu grimorio está vacío. Reclama tus conjuros pendientes.</p>
                        }
                        else
                        {
                            @foreach (var spell in CharDto.KnownSpells)
                            {
                                @DisplaySpellRowClean(spell)
                            }
                        }
                    </div>
                </div>

                <div class="bg-slate-900 border border-amber-900/20 rounded-3xl p-5 shadow-xl space-y-4">
                    <div class="flex justify-between items-center border-b border-amber-900/10 pb-3">
                        <h3 class="text-amber-500 font-black text-xs flex items-center gap-2 uppercase tracking-wider">
                            <i class="fa-solid fa-list-check text-amber-700"></i> @L["Title_Skills"]
                        </h3>
                        <span class="text-[10px] font-mono font-black text-slate-500 bg-black/50 px-2 py-0.5 rounded-full">
                            Prof: +@CharDto.ProficiencyBonus
                        </span>
                    </div>
                    <div class="space-y-1.5 max-h-[350px] overflow-y-auto pr-1">
                        @foreach (var skill in SkillMap.OrderBy(s => L[s.Key].Value))
                        {
                            @DisplaySkillRowClean(skill.Key, skill.Value)
                        }
                    </div>
                </div>

                <div class="bg-slate-900 border border-amber-900/20 rounded-3xl p-5 shadow-xl space-y-4">
                    <h3 class="text-amber-500 font-black text-xs flex items-center gap-2 uppercase tracking-wider border-b border-amber-900/10 pb-3">
                        <i class="fa-solid fa-scroll text-amber-700"></i> @L["Title_ClassAndRaceFeatures"]
                    </h3>
                    <div class="space-y-3 max-h-[350px] overflow-y-auto pr-1">
                        @if (!CharDto.AcquiredFeatures.Any())
                        {
                            <p class="text-slate-600 italic text-xs font-serif p-4 text-center bg-black/20 rounded-xl">@L["Msg_EmptyAdventureJournal"]</p>
                        }
                        else
                        {
                            @foreach (var feature in CharDto.AcquiredFeatures)
                            {
                                <div class="bg-black/30 border border-slate-800/80 p-3.5 rounded-2xl space-y-1">
                                    <h4 class="text-white font-bold text-xs uppercase tracking-wide">@feature.Name</h4>
                                    <p class="text-slate-400 text-[11px] leading-relaxed">@((MarkupString)feature.Description)</p>
                                </div>
                            }
                        }
                    </div>
                </div>

            </div>

            @if (showRaceModal && CharDto.Race != null)
            {
                <div class="fixed inset-0 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4 z-50" @onclick="() => showRaceModal = false">
                    <div class="relative w-full max-w-lg rounded-3xl border border-slate-800 bg-slate-950 p-6 shadow-2xl flex flex-col max-h-[80vh]" @onclick:stopPropagation>
                        <button @onclick="() => showRaceModal = false" class="absolute top-4 right-4 text-slate-500 hover:text-white size-8 flex items-center justify-center rounded-full bg-white/5 z-20">
                            <i class="fa-solid fa-xmark text-sm"></i>
                        </button>
                        <div class="overflow-y-auto pr-1 flex-1">
                            <RaceInspector RaceDto="CharDto.Race" />
                        </div>
                    </div>
                </div>
            }

            @if (showClassModal && CharDto.ClassDef != null)
            {
                <div class="fixed inset-0 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4 z-50" @onclick="() => showClassModal = false">
                    <div class="relative w-full max-w-lg rounded-3xl border border-slate-800 bg-slate-950 p-6 shadow-2xl flex flex-col max-h-[80vh]" @onclick:stopPropagation>
                        <button @onclick="() => showClassModal = false" class="absolute top-4 right-4 text-slate-500 hover:text-white size-8 flex items-center justify-center rounded-full bg-white/5 z-20">
                            <i class="fa-solid fa-xmark text-sm"></i>
                        </button>
                        <div class="overflow-y-auto pr-1 flex-1">
                            <ClassInspector InspectedClass="CharDto.ClassDef" />
                        </div>
                    </div>
                </div>
            }

            @if (showSpellModal && selectedSpellForModal != null)
            {
                <div class="fixed inset-0 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4 z-50" @onclick="CloseSpellModal">
                    <div class="relative w-full max-w-md rounded-3xl border border-slate-800 bg-slate-950 p-6 shadow-2xl flex flex-col max-h-[75vh]" @onclick:stopPropagation>
                        <button @onclick="CloseSpellModal" class="absolute top-4 right-4 text-slate-500 hover:text-white size-8 flex items-center justify-center rounded-full bg-white/5 z-20">
                            <i class="fa-solid fa-xmark text-sm"></i>
                        </button>

                        <div class="overflow-y-auto pr-1 space-y-3">
                            <div>
                                <span class="text-[9px] font-mono font-black text-amber-500 uppercase tracking-widest">
                                    @(selectedSpellForModal.Level == 0 ? "Cantrip" : $"Nivel {selectedSpellForModal.Level}") • @selectedSpellForModal.School
                                </span>
                                <h3 class="text-xl font-black text-white uppercase italic tracking-tight mt-0.5">@selectedSpellForModal.Name</h3>
                            </div>

                            <div class="grid grid-cols-2 gap-2 text-[11px] font-mono bg-black/40 p-2.5 rounded-xl border border-slate-800/80">
                                <div>
                                    <span class="text-slate-500 text-[9px] block uppercase font-bold">Tiempo</span>
                                    <span class="text-slate-200">@selectedSpellForModal.CastingTime</span>
                                </div>
                                <div>
                                    <span class="text-slate-500 text-[9px] block uppercase font-bold">Alcance</span>
                                    <span class="text-slate-200">@selectedSpellForModal.Range</span>
                                </div>
                                <div class="col-span-2 border-t border-slate-800/60 pt-1.5 mt-0.5">
                                    <span class="text-slate-500 text-[9px] block uppercase font-bold">Duración</span>
                                    <span class="text-slate-200">@selectedSpellForModal.Duration</span>
                                </div>
                            </div>

                            <div class="bg-black/20 p-3.5 rounded-xl border border-white/5 font-serif text-xs text-slate-300 leading-relaxed">
                                @((MarkupString)selectedSpellForModal.Description)
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>

@code {
    [Parameter] public Guid CharacterId { get; set; }
    private CharacterDto? CharDto;
    private CharacterAuditDto? AuditStatus;

    private bool showRaceModal = false;
    private bool showClassModal = false;
    private bool showSpellModal = false;
    private SpellDto? selectedSpellForModal;

    private List<string> trainedSkills = new();

    protected override async Task OnInitializedAsync()
    {
        CharDto = await CharacterService.GetByIdAsync(CharacterId, q => q.Include(x => x.KnownSpells).Include(x => x.SpellSlots));
        AuditStatus = await LevelUpService.AuditCharacterAsync(CharacterId);

        if (CharDto?.ClassDef?.SkillProficiencies != null)
        {
            trainedSkills = CharDto.ClassDef.SkillProficiencies
                .Select(s => s.TechnicalName)
                .ToList();
        }
    }

    private void OpenRaceCompendium() => showRaceModal = true;
    private void OpenClassCompendium() => showClassModal = true;
    private void OpenSpellInspector(SpellDto spell) { selectedSpellForModal = spell; showSpellModal = true; }
    private void CloseSpellModal() => showSpellModal = false;

    private void NavigateToLevelUp() => Navigation.NavigateTo($"/character/{CharDto?.Id}/levelup");
    private void Back() => Navigation.NavigateTo("/characters");

    // 🌟 Atributo Minimalista para móviles
    private RenderFragment DisplayAttributeMinimalist(string shortName, int mod) => __builder =>
    {
        <div class="bg-slate-900 border border-amber-900/10 p-2.5 rounded-2xl flex flex-col items-center justify-center shadow-md">
            <span class="text-[9px] font-black text-slate-500 tracking-wider uppercase">@shortName</span>
            <span class="text-2xl font-black tracking-tighter my-0.5 @(mod >= 0 ? "text-lime-500" : "text-red-500")">
                @(mod >= 0 ? "+" : "")@mod
            </span>
        </div>
    };

    private RenderFragment DisplaySkillRowClean(string skillKey, string stat) => __builder =>
    {
        var bonus = CharDto!.GetSkillBonus(skillKey, stat, trainedSkills);
        bool isProficient = trainedSkills.Contains(skillKey);

        <div class="flex items-center justify-between py-1.5 border-b border-amber-900/5 px-2 text-xs">
            <div class="flex items-center gap-2.5 min-w-0">
                <div class="size-2 rounded-full shrink-0 @(isProficient ? "bg-lime-500 shadow-[0_0_6px_rgba(132,204,22,0.8)]" : "border border-slate-700 bg-black/20")"></div>
                <div class="truncate">
                    <span class="font-medium text-slate-300">@L[skillKey]</span>
                    <span class="text-[8px] text-amber-700/50 font-black uppercase ml-1 font-mono">@shortStatMap[stat]</span>
                </div>
            </div>
            <span class="font-mono font-black text-xs px-2 py-0.5 rounded bg-black/40 border border-white/5 min-w-[28px] text-center @(bonus >= 0 ? "text-lime-500" : "text-red-500")">
                @(bonus >= 0 ? "+" : "")@bonus
            </span>
        </div>
    };

    private RenderFragment DisplaySpellRowClean(SpellDto spell) => __builder =>
    {
        <div @onclick="() => OpenSpellInspector(spell)"
             class="bg-black/30 border border-slate-800/80 p-3 rounded-2xl flex items-center justify-between cursor-pointer text-xs group">
            <div class="min-w-0 pr-2">
                <h4 class="font-bold text-slate-200 group-hover:text-amber-400 transition-colors uppercase tracking-wide truncate">@spell.Name</h4>
                <span class="text-[9px] font-mono text-slate-500 uppercase">@L["Label_LevelShort"] @spell.Level</span>
            </div>

            <div class="flex items-center gap-1.5 shrink-0" @onclick:stopPropagation>
                <button @onclick="() => CastSpell((int)spell.Level, (int)spell.Level)"
                        disabled="@(!HasSlotsAvailable((int)spell.Level))"
                        class="px-2.5 py-1 bg-cyan-600 hover:bg-cyan-500 disabled:opacity-20 text-black font-black font-mono rounded-xl uppercase text-[10px]">
                    Cast @spell.Level
                </button>
            </div>
        </div>
    };

    private bool HasSlotsAvailable(int slotLevel)
    {
        if (slotLevel == 0) return true;
        var slot = CharDto?.SpellSlots?.FirstOrDefault(s => s.Level == slotLevel);
        return slot != null && slot.RemainingSlots > 0;
    }

    private readonly Dictionary<string, string> shortStatMap = new()
    {
        { "Strength", "STR" }, { "Dexterity", "DEX" }, { "Constitution", "CON" },
        { "Intelligence", "INT" }, { "Wisdom", "WIS" }, { "Charisma", "CHA" }
    };

    private readonly Dictionary<string, string> SkillMap = new()
    {
        { "Acrobatics", "Dexterity" }, { "Athletics", "Strength" }, { "Arcana", "Intelligence" },
        { "Deception", "Charisma" }, { "History", "Intelligence" }, { "Performance", "Charisma" },
        { "Intimidation", "Charisma" }, { "Investigation", "Intelligence" }, { "SleightOfHand", "Dexterity" },
        { "Medicine", "Wisdom" }, { "Nature", "Intelligence" }, { "Perception", "Wisdom" },
        { "Insight", "Wisdom" }, { "Persuasion", "Charisma" }, { "Religion", "Intelligence" },
        { "Stealth", "Dexterity" }, { "Survival", "Wisdom" }, { "AnimalHandling", "Wisdom" }
    };

    private void NavigateToClaimRewards()
    {
        if (CharDto != null) Navigation.NavigateTo($"/character/{CharDto.Id}/levelup?mode=claim");
    }

    private async Task TriggerLongRest()
    {
        if (CharDto == null) return;
        await SpellService.RestRestoreSlotsAsync(CharDto.Id);
        CharDto = await CharacterService.GetByIdAsync(CharacterId, q => q.Include(x => x.KnownSpells).Include(x => x.SpellSlots));
    }

    private async Task CastSpell(int spellBaseLevel, int slotLevelToUse)
    {
        if (CharDto == null) return;
        bool success = await SpellService.CastSpellAsync(CharDto.Id, spellBaseLevel, slotLevelToUse);
        if (success)
        {
            CharDto = await CharacterService.GetByIdAsync(CharacterId, q => q.Include(x => x.KnownSpells).Include(x => x.SpellSlots));
        }
    }
}}
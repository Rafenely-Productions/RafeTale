@page "/character/{CharacterId:guid}"
@using DnDreams.Application.DTOs
@using DnDreams.Application.Interfaces.DtosInterfaces
@using DnDreams.Domain.Entities
@inject IService<CharacterDto, Character> CharacterService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject ISpellServiceSystem SpellService
@inject ILevelUpService LevelUpService

<div class="min-h-screen bg-black p-4 md:p-6 text-slate-100 selection:bg-amber-500/30">
    @if (CharDto == null)
    {
        <div class="flex flex-col items-center justify-center py-32">
            <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-amber-500 mb-4"></div>
            <p class="text-amber-500 italic font-serif text-sm">@L["Msg_SummoningHero"]</p>
        </div>
    }
    else
    {
        <div class="max-w-5xl mx-auto space-y-6">

            <button @onclick="Back"
                    class="flex items-center gap-2 text-amber-700 hover:text-amber-500 font-black text-[10px] tracking-[0.2em] transition-colors group uppercase">
                <i class="fa-solid fa-arrow-left transition-transform group-hover:-translate-x-1"></i>
                @L["Btn_ReturnToTavern"]
            </button>

            <div class="relative overflow-hidden flex flex-col md:flex-row justify-between items-center gap-6 bg-slate-900 border border-amber-900/20 p-6 md:p-8 rounded-[2rem] shadow-2xl">
                
                <div class="absolute -left-6 -top-6 opacity-5 text-9xl text-white pointer-events-none">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>

                <div class="relative z-10 text-center md:text-left min-w-0">
                    <h1 class="text-4xl md:text-5xl font-black text-amber-500 tracking-tight italic uppercase mb-2 truncate">@CharDto.Name</h1>
                    
                    <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5">
                        <div class="inline-flex items-center rounded-lg bg-black/40 border border-slate-800 p-1 pl-2.5 text-xs">
                            <span class="text-slate-300 font-serif italic mr-2">@CharDto.Race?.Name</span>
                            <button @onclick="OpenRaceCompendium" class="size-6 rounded-md bg-amber-500/10 text-amber-500 hover:bg-amber-500 hover:text-black transition-all flex items-center justify-center">
                                <i class="fa-solid fa-book-atlas text-[11px]"></i>
                            </button>
                        </div>

                        <div class="inline-flex items-center rounded-lg bg-black/40 border border-slate-800 p-1 pl-2.5 text-xs">
                            <span class="text-amber-500/90 font-black uppercase tracking-wide mr-2 text-[11px]">@CharDto.ClassDef?.Name</span>
                            <button @onclick="OpenClassCompendium" class="size-6 rounded-md bg-amber-500/10 text-amber-500 hover:bg-amber-500 hover:text-black transition-all flex items-center justify-center">
                                <i class="fa-solid fa-book-atlas text-[11px]"></i>
                            </button>
                        </div>

                        <span class="bg-amber-500 text-black px-3 py-1 rounded-lg text-xs font-black uppercase font-mono tracking-wider shadow-sm shadow-amber-500/10">
                            @L["Label_Level"] @CharDto.Level
                        </span>
                    </div>
                </div>

                <div class="relative z-10 shrink-0 w-full md:w-auto">
                    <button @onclick="NavigateToLevelUp"
                            class="group w-full md:w-auto bg-lime-600 hover:bg-lime-500 text-black px-6 py-3.5 rounded-xl font-black text-xs uppercase tracking-wider transition-all shadow-lg shadow-lime-900/20 flex items-center justify-center gap-2.5 active:scale-[0.98]">
                        @L["Btn_LevelUp"] <i class="fa-solid fa-arrow-up group-hover:-translate-y-0.5 transition-transform"></i>
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-3 md:grid-cols-6 gap-3">
                @DisplayAttributeCompact(L["Strength"], "STR", CharDto.Strength, CharDto.StrModifier)
                @DisplayAttributeCompact(L["Dexterity"], "DEX", CharDto.Dexterity, CharDto.DexModifier)
                @DisplayAttributeCompact(L["Constitution"], "CON", CharDto.Constitution, CharDto.ConModifier)
                @DisplayAttributeCompact(L["Intelligence"], "INT", CharDto.Intelligence, CharDto.IntModifier)
                @DisplayAttributeCompact(L["Wisdom"], "WIS", CharDto.Wisdom, CharDto.WisModifier)
                @DisplayAttributeCompact(L["Charisma"], "CHA", CharDto.Charisma, CharDto.ChaModifier)
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
                
                <div class="md:col-span-1 bg-slate-900 border border-amber-900/20 rounded-[2rem] p-5 shadow-xl space-y-4">
                    <div class="flex flex-col gap-1 border-b border-amber-900/10 pb-3">
                        <h3 class="text-amber-500 font-black text-sm flex items-center gap-2 uppercase tracking-wide">
                            <i class="fa-solid fa-list-check text-amber-700"></i> @L["Title_Skills"]
                        </h3>
                        <span class="text-[9px] font-mono font-black text-slate-500 tracking-wider">
                            @L["Label_ProficiencyBonus"]: +@CharDto.ProficiencyBonus
                        </span>
                    </div>

                    <div class="space-y-1 max-h-[400px] overflow-y-auto pr-1 custom-scrollbar">
                        @foreach (var skill in SkillMap.OrderBy(s => L[s.Key].Value))
                        {
                            @DisplaySkillRow(skill.Key, skill.Value)
                        }
                    </div>
                </div>

                <div class="md:col-span-2 bg-slate-900 border border-amber-900/20 rounded-[2rem] p-6 shadow-xl space-y-4">
                    <h3 class="text-amber-500 font-black text-sm flex items-center gap-2 uppercase tracking-wide border-b border-amber-900/10 pb-3">
                        <i class="fa-solid fa-scroll text-amber-700"></i> @L["Title_ClassAndRaceFeatures"]
                    </h3>

                    <div class="space-y-3 max-h-[400px] overflow-y-auto pr-1 custom-scrollbar">
                        @if (!CharDto.AcquiredFeatures.Any())
                        {
                            <p class="text-slate-600 italic text-xs font-serif p-4 text-center">@L["Msg_EmptyAdventureJournal"]</p>
                        }
                        else
                        {
                            @foreach (var feature in CharDto.AcquiredFeatures)
                            {
                                <div class="bg-black/30 border border-slate-800/80 p-4 rounded-xl group hover:border-amber-500/20 transition-all duration-200">
                                    <h4 class="text-white font-bold text-sm mb-1 group-hover:text-amber-400 transition-colors uppercase tracking-wide">@feature.Name</h4>
                                    <p class="text-slate-400 text-xs font-sans leading-relaxed">@((MarkupString)feature.Description)</p>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            @if (showRaceModal && CharDto.Race != null)
            {
                <div class="fixed inset-0 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4 z-50 animate-in fade-in duration-150" @onclick="() => showRaceModal = false">
                    <div class="relative w-full max-w-3xl rounded-3xl border border-slate-800 bg-slate-950 p-6 shadow-2xl overflow-hidden flex flex-col max-h-[85vh]" @onclick:stopPropagation>
                        <button @onclick="() => showRaceModal = false" class="absolute top-4 right-4 text-slate-500 hover:text-white size-8 flex items-center justify-center rounded-lg hover:bg-white/5 transition-colors z-20">
                            <i class="fa-solid fa-xmark text-lg"></i>
                        </button>
                        <div class="overflow-y-auto pr-1 custom-scrollbar flex-1">
                            <RaceInspector RaceDto="CharDto.Race" />
                        </div>
                    </div>
                </div>
            }

            @if (showClassModal && CharDto.ClassDef != null)
            {
                <div class="fixed inset-0 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4 z-50 animate-in fade-in duration-150" @onclick="() => showClassModal = false">
                    <div class="relative w-full max-w-4xl rounded-3xl border border-slate-800 bg-slate-950 p-6 shadow-2xl overflow-hidden flex flex-col max-h-[85vh]" @onclick:stopPropagation>
                        <button @onclick="() => showClassModal = false" class="absolute top-4 right-4 text-slate-500 hover:text-white size-8 flex items-center justify-center rounded-lg hover:bg-white/5 transition-colors z-20">
                            <i class="fa-solid fa-xmark text-lg"></i>
                        </button>
                        <div class="overflow-y-auto pr-1 custom-scrollbar flex-1">
                            <ClassInspector InspectedClass="CharDto.ClassDef" />
                        </div>
                    </div>
                </div>
            }

        </div>
        @if (AuditStatus != null && AuditStatus.HasPendingChoices)
        {
            <div class="bg-amber-500/10 border border-amber-500/30 p-4 rounded-2xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 animate-in fade-in duration-300">
                <div class="flex items-center gap-3 text-xs">
                    <div class="size-8 rounded-xl bg-amber-500/20 text-amber-500 flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-sparkles text-sm animate-pulse"></i>
                    </div>
                    <div>
                        <p class="font-black text-amber-500 uppercase tracking-wider">@L["Title_PendingSelections"]</p>
                        <p class="text-slate-400 mt-0.5">
                            @if (AuditStatus.PendingFeats > 0)
                            {
                                <span>@L["Msg_PendingFeats", AuditStatus.PendingFeats] </span>
                            }
                            @if (AuditStatus.PendingSpells > 0)
                            {
                                <span>@L["Msg_PendingSpells", AuditStatus.PendingSpells]</span>
                            }
                        </p>
                    </div>
                </div>

                <button @onclick="NavigateToClaimRewards" class="w-full sm:w-auto px-4 py-2 bg-amber-500 hover:bg-amber-400 text-black font-black text-[10px] rounded-lg uppercase tracking-widest shadow-md transition-all active:scale-95">
                    @L["Btn_ClaimSelections"]
                </button>
            </div>
        }
    }
</div>
@if (CharDto.SpellSlots != null && CharDto.SpellSlots.Any())
{
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="md:col-span-1 bg-slate-900 border border-amber-900/20 rounded-[2rem] p-6 shadow-xl space-y-4">
            <div class="flex justify-between items-center border-b border-amber-900/10 pb-3">
                <h3 class="text-amber-500 font-black text-sm uppercase tracking-wide flex items-center gap-2">
                    <i class="fa-solid fa-wand-sparkles text-amber-700"></i> @L["Title_SpellSlots"]
                </h3>
                <button @onclick="TriggerLongRest" class="px-2.5 py-1 text-[9px] font-black bg-amber-500/10 text-amber-500 hover:bg-amber-500 hover:text-black border border-amber-500/20 rounded-lg transition-all uppercase tracking-wider">
                    <i class="fa-solid fa-bed text-xs"></i> Long Rest
                </button>
            </div>

            <div class="space-y-3">
                @foreach (var slot in CharDto.SpellSlots.OrderBy(s => s.Level))
                {
                    <div class="bg-black/30 border border-slate-800 p-3 rounded-xl flex flex-col gap-2">
                        <div class="flex justify-between items-center text-xs">
                            <span class="font-bold text-slate-300">@L["Label_SlotLevel"] @slot.Level</span>
                            <span class="font-mono text-[10px] text-amber-500/70 font-black">@slot.RemainingSlots / @slot.MaxSlots</span>
                        </div>

                        <div class="flex flex-wrap gap-1.5">
                            @for (int i = 0; i < slot.MaxSlots; i++)
                            {
                                var currentPipIndex = i;
                                bool isUsed = currentPipIndex < slot.UsedSlots;

                                <div class="size-4 rounded-full transition-all duration-300 border cursor-pointer
                                                                     @(isUsed
                                                                                                 ? "bg-slate-950 border-slate-800 shadow-inner"
                                                                                                 : "bg-cyan-500 border-cyan-400 shadow-[0_0_8px_rgba(6,182,212,0.6)] animate-pulse")"
                         title="@(isUsed? L["Tip_ExpendedSlot"] : L["Tip_AvailableSlot"])">
                    </div>
                                        }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="md:col-span-2 bg-slate-900 border border-amber-900/20 rounded-[2rem] p-6 shadow-xl space-y-4">
            <h3 class="text-amber-500 font-black text-sm uppercase tracking-wide flex items-center gap-2 border-b border-amber-900/10 pb-3">
                <i class="fa-solid fa-book-sparkles text-amber-700"></i> @L["Title_Spellbook"]
            </h3>

            <div class="space-y-2 max-h-[380px] overflow-y-auto pr-1 custom-scrollbar">
                @DisplaySpellRowMock("Proyectil Mágico (Magic Missile)", 1)
                @DisplaySpellRowMock("Escudo (Shield)", 1)
                @DisplaySpellRowMock("Paso Misterioso (Misty Step)", 2)
            </div>
        </div>

    </div>
}
@code {
    [Parameter] public Guid CharacterId { get; set; }
    private CharacterDto? CharDto;
    private CharacterAuditDto? AuditStatus;

    // Modales de Compendio
    private bool showRaceModal = false;
    private bool showClassModal = false;


    private List<string> trainedSkills = new();

    protected override async Task OnInitializedAsync()
    {
        CharDto = await CharacterService.GetByIdAsync(CharacterId);
        AuditStatus = await LevelUpService.AuditCharacterAsync(CharacterId);

        if (CharDto?.ClassDef?.SkillProficiencies != null)
        {
            trainedSkills = CharDto.ClassDef.SkillProficiencies
                .Select(s => s.TechnicalName)
                .ToList();
        }
    }

    private void OpenRaceCompendium() => showRaceModal = true;
    private void OpenClassCompendium() => showClassModal = true;

    private void NavigateToLevelUp() => Navigation.NavigateTo($"/character/{CharDto?.Id}/levelup");
    private void Back() => Navigation.NavigateTo("/characters");

    // 🚨 COMPACTO: RenderFragment de Atributo Horizontal optimizado para MAUI
    private RenderFragment DisplayAttributeCompact(string name, string shortName, int score, int mod) => __builder =>
    {
        <div class="bg-slate-900 border border-amber-900/10 p-3 rounded-2xl flex flex-col items-center justify-center relative group hover:border-amber-500/30 transition-all duration-200 shadow-md">
            <span class="text-[9px] font-black text-slate-500 tracking-wider uppercase">@shortName</span>
            
            <span class="text-2xl md:text-3xl font-black tracking-tighter my-0.5 @(mod >= 0 ? "text-lime-500" : "text-red-500")">
                @(mod >= 0 ? "+" : "")@mod
            </span>
            
            <div class="text-[10px] font-bold text-slate-400 bg-black/40 border border-white/5 px-2 py-0.5 rounded-md mt-0.5 font-mono">
                @score
            </div>
        </div>
    };

    // Fila compacta de Habilidad
    private RenderFragment DisplaySkillRow(string skillKey, string stat) => __builder =>
    {
        var bonus = CharDto!.GetSkillBonus(skillKey, stat, trainedSkills);
        bool isProficient = trainedSkills.Contains(skillKey);

        <div class="flex items-center justify-between py-1.5 border-b border-amber-900/5 hover:bg-amber-500/5 transition-all px-2 rounded-lg group text-xs">
            <div class="flex items-center gap-2.5 min-w-0">
                <div class="size-2.5 rounded-full shrink-0 transition-all duration-300 @(isProficient ? "bg-lime-500 shadow-[0_0_8px_rgba(132,204,22,0.8)]" : "border border-slate-700 bg-black/20")">
                </div>
                <div class="truncate">
                    <span class="font-medium text-slate-300 group-hover:text-white transition-colors truncate">@L[skillKey]</span>
                    <span class="text-[8px] text-amber-700/40 font-black uppercase ml-1 tracking-tighter font-mono">@shortStatMap[stat]</span>
                </div>
            </div>
            <span class="font-mono font-black text-xs px-1.5 py-0.5 rounded bg-black/40 border border-white/5 shrink-0 min-w-[28px] text-center @(bonus >= 0 ? "text-lime-500" : "text-red-500")">
                @(bonus >= 0 ? "+" : "")@bonus
            </span>
        </div>
    };
    // Gatillo para restaurar slots (Descanso Largo oficial)
    private async Task TriggerLongRest()
    {
        if (CharDto == null) return;
        await SpellService.RestRestoreSlotsAsync(CharDto.Id);

        // Recargamos el DTO de la base de datos para refrescar las burbujas de inmediato en Blazor
        CharDto = await CharacterService.GetByIdAsync(CharacterId);
    }

    // Método para castear conjuros usando el motor de Upcasting
    private async Task CastSpell(int spellBaseLevel, int slotLevelToUse)
    {
        if (CharDto == null) return;

        bool success = await SpellService.CastSpellAsync(CharDto.Id, spellBaseLevel, slotLevelToUse);
        if (success)
        {
            // Refrescar UI reactivamente
            CharDto = await CharacterService.GetByIdAsync(CharacterId);
        }
    }

    // Render auxiliar temporal para simular conjuros en el libro de magia antes de conectarlo a tu tabla Spells
    private RenderFragment DisplaySpellRowMock(string name, int level) => __builder =>
    {
        <div class="bg-black/30 border border-slate-800/80 p-3 rounded-xl flex items-center justify-between hover:border-amber-500/20 transition-all text-xs group">
            <div>
                <h4 class="font-bold text-slate-200 group-hover:text-amber-400 transition-colors uppercase tracking-wide">@name</h4>
                <span class="text-[9px] font-mono text-slate-500 uppercase">@L["Label_LevelShort"] @level</span>
            </div>

            <div class="flex items-center gap-1.5">
                <button @onclick="() => CastSpell(level, level)"
                        disabled="@(!HasSlotsAvailable(level))"
                        class="px-3 py-1.5 bg-cyan-600 hover:bg-cyan-500 disabled:opacity-20 disabled:pointer-events-none text-black font-black font-mono rounded-lg transition-all uppercase text-[10px]">
                    Cast Lvl @level
                </button>

                @if (level == 1 && HasSlotsAvailable(2))
                {
                    <button @onclick="() => CastSpell(level, 2)"
                            class="px-2 py-1.5 bg-purple-900/40 border border-purple-500/30 text-purple-400 hover:bg-purple-500 hover:text-black font-mono rounded-lg transition-all text-[9px]">
                        Upcast L2
                    </button>
                }
            </div>
        </div>
    };

    private bool HasSlotsAvailable(int slotLevel)
    {
        var slot = CharDto?.SpellSlots?.FirstOrDefault(s => s.Level == slotLevel);
        return slot != null && slot.RemainingSlots > 0;
    }
    private readonly Dictionary<string, string> shortStatMap = new()
    {
        { "Strength", "STR" }, { "Dexterity", "DEX" }, { "Constitution", "CON" },
        { "Intelligence", "INT" }, { "Wisdom", "WIS" }, { "Charisma", "CHA" }
    };

    private readonly Dictionary<string, string> SkillMap = new()
    {
        { "Acrobatics", "Dexterity" }, { "Athletics", "Strength" }, { "Arcana", "Intelligence" },
        { "Deception", "Charisma" }, { "History", "Intelligence" }, { "Performance", "Charisma" },
        { "Intimidation", "Charisma" }, { "Investigation", "Intelligence" }, { "SleightOfHand", "Dexterity" },
        { "Medicine", "Wisdom" }, { "Nature", "Intelligence" }, { "Perception", "Wisdom" },
        { "Insight", "Wisdom" }, { "Persuasion", "Charisma" }, { "Religion", "Intelligence" },
        { "Stealth", "Dexterity" }, { "Survival", "Wisdom" }, { "AnimalHandling", "Wisdom" }
    };

    private void NavigateToClaimRewards()
    {
        if (CharDto != null)
        {
            Navigation.NavigateTo($"/character/{CharDto.Id}/levelup?mode=claim");
        }
    }
}
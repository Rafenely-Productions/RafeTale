@page "/character/create/abilities"
@using DnDreams.Application.DTOs
@using DnDreams.Application.Interfaces.DtosInterfaces
@using DnDreams.Application.Services.DtosServices
@using DnDreams.Domain.Enums
@using DnDreams.Domain.Entities
@inject CharacterCreationService CreationService
@inject IService<BackgroundDto, Background> BackgroundService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject IUnitOfWork UnitOfWork

<div class="min-h-screen bg-black p-4 sm:p-6 text-white">
    <div class="max-w-4xl mx-auto space-y-4">

        <div class="flex items-center justify-between border-b border-white/5 pb-3 mt-2 sm:mt-4">
            <div>
                <button @onclick="Back" class="text-amber-700 hover:text-amber-500 text-[10px] font-black tracking-widest uppercase flex items-center gap-2 transition-colors mb-2">
                    <i class="fa-solid fa-arrow-left"></i> @L["Btn_Back"]
                </button>
                <h1 class="text-3xl sm:text-4xl font-black text-amber-500 italic uppercase tracking-tighter">@L["Abilities_Title"]</h1>
            </div>
        </div>

        @if (backgroundDto == null)
        {
            <div class="flex items-center justify-center p-12">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-amber-500"></div>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-slate-900 border border-amber-950 rounded-2xl p-4 sm:p-5 shadow-xl">

                <div class="flex flex-col justify-center space-y-2 pl-1 md:pl-2">
                    <span class="text-[10px] font-black text-amber-500 uppercase tracking-widest">@L["Background_Bonus"] (@backgroundDto.Name)</span>
                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var allowedAsi in backgroundDto.ASIs)
                        {
                            <span class="text-[10px] font-bold bg-slate-950 border border-slate-800 text-slate-300 px-2.5 py-0.5 rounded uppercase">
                                @L[allowedAsi.ToString()]
                            </span>
                        }
                    </div>
                </div>

                <div class="flex flex-col justify-center space-y-2 pl-1 md:pl-0 md:items-end border-t md:border-t-0 pt-3 md:pt-0 border-slate-800/60">
                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Background Bonus Status</span>

                    <div class="text-xs font-bold px-3 py-1 rounded-lg border transition-all flex items-center gap-2 @GetBonusStatusStyling()">
                        <i class="@GetBonusStatusIcon()"></i>
                        <span>@GetBonusStatusMessage()</span>
                    </div>
                </div>
            </div>

            <div class="bg-slate-900/60 border border-slate-800/60 rounded-xl px-4 py-3 flex flex-wrap items-center justify-between gap-2 shadow-md">
                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Standard Array Available:</span>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var score in availableScores)
                    {
                        bool isAssigned = baseScores.Values.Contains(score);
                        <span class="text-xs font-mono font-bold px-2 py-0.5 rounded border transition-all @(isAssigned ? "bg-slate-950/40 border-slate-900 text-slate-600 line-through" : "bg-slate-950 border-amber-500/30 text-amber-400")">
                            @score
                        </span>
                    }
                </div>
            </div>

            <div class="bg-slate-900 border border-amber-900/20 rounded-2xl p-3 sm:p-4 shadow-2xl space-y-2">
                @foreach (var ability in Enum.GetValues<ASI>())
                {
                    var finalScore = CalculateFinalScore(ability);
                    var modifier = CalculateModifier(finalScore);
                    var isAllowedByBg = backgroundDto.ASIs.Contains(ability);

                    <div class="px-3 py-2 bg-black/50 rounded-xl border border-slate-800/80 flex items-center justify-between gap-2">

                        <div class="flex items-center gap-2.5 min-w-0">
                            <div class="size-9 shrink-0 rounded-lg bg-slate-950 border border-slate-800 flex flex-col items-center justify-center">
                                <span class="text-[7px] font-black text-slate-500 uppercase leading-none mb-0.5">@ability.ToString().Substring(0, 3)</span>
                                <span class="text-[11px] font-black text-amber-400 leading-none">@(modifier >= 0 ? $"+{modifier}" : modifier.ToString())</span>
                            </div>
                            <div class="min-w-0">
                                <p class="text-[11px] font-black text-white uppercase tracking-wide truncate">@L[ability.ToString()]</p>
                                <p class="text-[9px] text-slate-400">Tot: <span class="text-amber-500 font-bold font-mono">@finalScore</span></p>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 shrink-0">

                            <div class="flex items-center gap-1">
                                <label class="text-[8px] font-bold text-slate-500 uppercase">Base</label>
                                <select value="@baseScores[ability]" @onchange="(e) => AssignBaseScore(ability, e)"
                                        class="bg-slate-950 border border-slate-800 text-white rounded-lg px-2 py-1 text-[11px] font-bold focus:border-amber-500 outline-none">
                                    <option value="0">--</option>
                                    @foreach (var val in availableScores)
                                    {
                                        @if (!baseScores.Values.Contains(val) || baseScores[ability] == val)
                                        {
                                            <option value="@val">@val</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="shrink-0">
                                @if (isAllowedByBg)
                                {
                                    <div class="inline-flex rounded-lg bg-slate-950 border border-slate-800 p-0.5 gap-0.5">
                                        <button type="button" @onclick="() => ToggleBonus(ability, 2)"
                                                class="px-2 py-0.5 rounded text-[9px] font-mono font-black transition-all @(asiPlusTwo == ability ? "bg-amber-500 text-black shadow-sm" : "text-slate-400 hover:text-white")"
                                                title="Asignar +2 (Exclusivo)">
                                            +2
                                        </button>
                                        <button type="button" @onclick="() => ToggleBonus(ability, 1)"
                                                class="px-2 py-0.5 rounded text-[9px] font-mono font-black transition-all @(asiPlusOnes.Contains(ability) ? "bg-amber-500 text-black shadow-sm" : "text-slate-400 hover:text-white")"
                                                title="Asignar +1">
                                            +1
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-[8px] font-mono text-slate-600 uppercase bg-slate-950 px-2 py-1 rounded border border-slate-900 block text-center">Lock</span>
                                }
                            </div>

                        </div>
                    </div>
                }
            </div>

            <div class="flex justify-end pt-2">
                <button @onclick="FinishCharacter"
                        disabled="@(!IsSelectionComplete())"
                        class="group w-full sm:w-auto px-8 py-3.5 bg-gradient-to-r from-lime-600 to-lime-500 hover:from-lime-500 hover:to-lime-400 text-black font-black rounded-xl transition-all duration-300 shadow-xl shadow-lime-900/20 disabled:opacity-20 disabled:grayscale uppercase tracking-tighter flex items-center justify-center gap-2">
                    <span class="text-xs">@L["Btn_FinishCharacter"]</span>
                    <i class="fa-solid fa-flag-checkered text-xs transition-transform duration-300 group-hover:scale-110"></i>
                </button>
            </div>
        }
    </div>
</div>

@code {
    private BackgroundDto? backgroundDto;
    private readonly List<int> availableScores = new() { 15, 14, 13, 12, 10, 8 };

    private Dictionary<ASI, int> baseScores = new()
    {
        { ASI.Strength, 0 },
        { ASI.Dexterity, 0 },
        { ASI.Constitution, 0 },
        { ASI.Intelligence, 0 },
        { ASI.Wisdom, 0 },
        { ASI.Charisma, 0 }
    };

    private ASI? asiPlusTwo;
    private List<ASI> asiPlusOnes = new();

    protected override async Task OnInitializedAsync()
    {
        if (CreationService.SelectedBackgroundId.HasValue)
        {
            backgroundDto = await BackgroundService.GetByIdAsync(CreationService.SelectedBackgroundId.Value);
        }
    }

    private void AssignBaseScore(ASI ability, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var score))
        {
            baseScores[ability] = score;
        }
    }

    private void ToggleBonus(ASI ability, int value)
    {
        if (value == 2)
        {
            if (asiPlusTwo == ability)
            {
                asiPlusTwo = null;
            }
            else
            {
                asiPlusTwo = ability;
                asiPlusOnes.Remove(ability);

                if (asiPlusOnes.Count > 1)
                {
                    var lastAdded = asiPlusOnes.Last();
                    asiPlusOnes.Clear();
                    asiPlusOnes.Add(lastAdded);
                }
            }
        }
        else if (value == 1)
        {
            if (asiPlusOnes.Contains(ability))
            {
                asiPlusOnes.Remove(ability);
            }
            else
            {
                if (asiPlusTwo == ability)
                {
                    asiPlusTwo = null;
                }

                if (asiPlusTwo != null)
                {
                    asiPlusOnes.Clear();
                    asiPlusOnes.Add(ability);
                }
                else
                {
                    if (asiPlusOnes.Count < 3)
                    {
                        asiPlusOnes.Add(ability);
                    }
                    else
                    {
                        asiPlusOnes.RemoveAt(0);
                        asiPlusOnes.Add(ability);
                    }
                }
            }
        }
    }

    // --- MÉTODOS DE UX (ESTADO DINÁMICO DE BONOS) ---
    private string GetBonusStatusMessage()
    {
        bool hasTwo = asiPlusTwo.HasValue;
        int onesCount = asiPlusOnes.Count;

        if (!hasTwo && onesCount == 0) return "Elige: (+2 y +1) ó (tres +1)";
        if (hasTwo && onesCount == 1) return "¡Bonos listos (+2 y +1)!";
        if (!hasTwo && onesCount == 3) return "¡Bonos listos (tres +1)!";

        if (hasTwo) return $"Tienes un +2. Falta 1 (+1)";
        return $"Llevas {onesCount}/3 bonos (+1)";
    }

    private string GetBonusStatusStyling()
    {
        bool isComplete = (asiPlusTwo.HasValue && asiPlusOnes.Count == 1) || (!asiPlusTwo.HasValue && asiPlusOnes.Count == 3);

        if (isComplete)
            return "bg-lime-950/40 border-lime-500/40 text-lime-400";

        return "bg-amber-950/40 border-amber-500/40 text-amber-400";
    }

    private string GetBonusStatusIcon()
    {
        bool isComplete = (asiPlusTwo.HasValue && asiPlusOnes.Count == 1) || (!asiPlusTwo.HasValue && asiPlusOnes.Count == 3);

        if (isComplete)
            return "fa-solid fa-circle-check text-lime-400";

        return "fa-solid fa-triangle-exclamation text-amber-400 animate-pulse";
    }

    private int CalculateFinalScore(ASI ability)
    {
        var baseScore = baseScores[ability];
        var bonus = 0;
        if (asiPlusTwo == ability) bonus = 2;
        else if (asiPlusOnes.Contains(ability)) bonus = 1;
        return baseScore + bonus;
    }

    private int CalculateModifier(int score)
    {
        if (score == 0) return 0;
        return (int)Math.Floor((score - 10) / 2.0);
    }

    private bool IsSelectionComplete()
    {
        bool allBasesAssigned = baseScores.Values.All(v => v > 0);

        bool backgroundBonusesAssigned =
            (asiPlusTwo.HasValue && asiPlusOnes.Count == 1) ||
            (!asiPlusTwo.HasValue && asiPlusOnes.Count == 3);

        return allBasesAssigned && backgroundBonusesAssigned;
    }

    private void Back()
    {
        Navigation.NavigateTo("/character/create");
    }

    private async Task FinishCharacter()
    {
        if (!IsSelectionComplete()) return;

        CreationService.BaseStats[ASI.Strength] = baseScores[ASI.Strength];
        CreationService.BaseStats[ASI.Dexterity] = baseScores[ASI.Dexterity];
        CreationService.BaseStats[ASI.Constitution] = baseScores[ASI.Constitution];
        CreationService.BaseStats[ASI.Intelligence] = baseScores[ASI.Intelligence];
        CreationService.BaseStats[ASI.Wisdom] = baseScores[ASI.Wisdom];
        CreationService.BaseStats[ASI.Charisma] = baseScores[ASI.Charisma];

        foreach (var stat in Enum.GetValues<ASI>())
        {
            var bonus = 0;
            if (asiPlusTwo == stat) bonus = 2;
            else if (asiPlusOnes.Contains(stat)) bonus = 1;

            CreationService.BonusStats[stat] = bonus;
        }

        try
        {
            var savedHero = await CreationService.CreateAndSaveCharacterAsync(UnitOfWork);
            Navigation.NavigateTo("/characters");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error guardando héroe: {ex.Message}");
        }
    }
}
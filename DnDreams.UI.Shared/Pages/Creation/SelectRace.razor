@page "/character/create/race"
@using DnDreams.Application.DTOs
@using DnDreams.Application.Interfaces.DtosInterfaces
@using DnDreams.Domain.Entities
@using DnDreams.Domain.Interfaces
@using DnDreams.UI.Shared.Components.Library
@inject IUnitOfWork UnitOfWork
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject CharacterCreationService CreationService
@inject IService<RaceDto,Race> RaceService

<div class="min-h-screen bg-black p-6">
    <div class="max-w-6xl mx-auto">

        <div class="mb-8">
            <button @onclick='Back' class="text-amber-700 hover:text-amber-500 text-[10px] font-black tracking-[0.3em] mb-4 uppercase flex items-center gap-2 transition-all">
                <i class="fa-solid fa-arrow-left"></i> @L["Btn_Back"]
            </button>
            <h1 class="text-5xl font-black text-amber-500 italic uppercase tracking-tighter">@L["Title_SelectRace"]</h1>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

            <div class="lg:col-span-4 space-y-3">
                @foreach (var dtoRace in DtoRaces)
                {
                    <div @onclick="() => SelectingRace(dtoRace)"
                         class="group cursor-pointer p-6 rounded-2xl border transition-all duration-300 @(SelectedRace?.Id == dtoRace.Id ? "bg-amber-600 border-amber-400 shadow-[0_0_20px_rgba(245,158,11,0.3)]" : "bg-slate-900 border-amber-900/20 hover:border-amber-500/50")">
                        <div class="flex justify-between items-center">
                            <span class="text-xl font-black uppercase tracking-tight @(SelectedRace?.Id == dtoRace.Id ? "text-black" : "text-white group-hover:text-amber-500")">
                                @dtoRace.Name
                            </span>
                            <i class="fa-solid fa-chevron-right @(SelectedRace?.Id == dtoRace.Id ? "text-black" : "text-amber-900/40")"></i>
                        </div>
                    </div>
                }
            </div>

            <div class="lg:col-span-8">
                <div class="bg-slate-900 border border-amber-900/30 rounded-[3rem] p-10 shadow-2xl min-h-[600px] relative overflow-hidden">

                    @if (SelectedRace == null)
                    {
                        <div class="flex flex-col items-center justify-center h-full py-20 text-center">
                            <i class="fa-solid fa-scroll text-amber-900/10 text-[10rem] mb-6"></i>
                            <p class="text-amber-700 font-serif italic text-xl">@L["Msg_SelectRacePrompt"]</p>
                        </div>
                    }
                    else
                    {
                        <RaceInspector RaceDto="SelectedRace" />
                        <div class="mt-12 pt-8 border-t border-white/5 flex justify-end">
                            <button @onclick="Confirm"
                                    class="group px-12 py-5 bg-amber-600 hover:bg-amber-500 text-black font-black rounded-[2rem] transition-all shadow-xl shadow-amber-900/20 flex items-center gap-4">
                                <span class="uppercase tracking-widest">@L["Btn_ConfirmRace"]</span>
                                <i class="fa-solid fa-arrow-right group-hover:translate-x-2 transition-transform"></i>
                            </button>


                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private List<RaceDto> DtoRaces = new();
    private RaceDto? SelectedRace;

    protected override async Task OnInitializedAsync()
    {
        DtoRaces = await RaceService.GetAllAsync(null, includes: query => query.Include(x => x.Languages).IncludeCollection(x => x.SubRaces, z => z.Traits).Include(x => x.Traits));

        if (CreationService.SelectedRaceId != null)
        {
            SelectedRace = DtoRaces.FirstOrDefault(x => x.Id == CreationService.SelectedRaceId);
        }
    }

    private void Back() => Navigation.NavigateTo("/character/create");
    private void SelectingRace(RaceDto race)
    {
        SelectedRace = race;
    }
    private void Confirm()
    {
        if (SelectedRace != null)
        {
            CreationService.SelectedRaceId = SelectedRace.Id;
            Navigation.NavigateTo("/character/create");
        }
    }
}

@page "/character/create/class"
@using DnDreams.Domain.Entities
@using DnDreams.Domain.Interfaces
@using DnDreams.Domain.Enums
@using DnDreams.Domain.DTOs
@inject IUnitOfWork UnitOfWork
@inject NavigationManager Navigation
@inject CharacterCreationService CreationService
@inject IStringLocalizer<AppStrings> L

<div class="min-h-screen bg-black p-6">
    <div class="max-w-6xl mx-auto">

        <div class="mb-8">
            <button @onclick='Back' class="text-amber-700 hover:text-amber-500 text-[10px] font-black tracking-[0.3em] mb-4 uppercase flex items-center gap-2 transition-all">
                <i class="fa-solid fa-arrow-left"></i> @L["Btn_Back"]
            </button>
            <h1 class="text-5xl font-black text-amber-500 italic uppercase tracking-tighter">@L["Title_SelectClass"]</h1>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

            <div class="lg:col-span-4 space-y-3">
                @foreach (var cls in Classes)
                {
                    <div @onclick="() => SelectedClass = cls"
                         class="group cursor-pointer p-6 rounded-2xl border transition-all duration-300 @(SelectedClass?.Id == cls.Id ? "bg-amber-600 border-amber-400 shadow-[0_0_20px_rgba(245,158,11,0.3)]" : "bg-slate-900 border-amber-900/20 hover:border-amber-500/50")">
                        <div class="flex justify-between items-center">
                            <span class="text-xl font-black uppercase tracking-tight @(SelectedClass?.Id == cls.Id ? "text-black" : "text-white group-hover:text-amber-500")">
                                @cls.Name
                            </span>
                            <i class="fa-solid fa-fire-bolt @(SelectedClass?.Id == cls.Id ? "text-black" : "text-amber-900/40")"></i>
                        </div>
                    </div>
                }
            </div>

            <div class="lg:col-span-8">
                <div class="bg-slate-900 border border-amber-900/30 rounded-[3rem] p-10 shadow-2xl min-h-[600px]">

                    @if (SelectedClass == null)
                    {
                        <div class="flex flex-col items-center justify-center h-full py-20 text-center">
                            <i class="fa-solid fa-hat-wizard text-amber-900/10 text-[10rem] mb-6"></i>
                            <p class="text-amber-700 font-serif italic text-xl">@L["Choose_Class"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="animate-in fade-in duration-500">
                            <div class="flex flex-wrap justify-between items-start gap-6 mb-8">
                                <div class="flex-1">
                                    <h2 class="text-6xl font-black text-white mb-2 uppercase italic tracking-tighter">@SelectedClass.Name</h2>
                                    <p class="text-slate-400 font-serif italic text-lg leading-relaxed">@SelectedClass.Description</p>
                                </div>

                                <div class="flex gap-4">
                                    <div class="bg-red-900/10 border border-red-900/30 p-4 rounded-3xl text-center min-w-[90px]">
                                        <span class="block text-[10px] font-black text-red-700 uppercase mb-1">@L["Label_HitDie"]</span>
                                        <span class="text-2xl font-black text-white">@SelectedClass.HitDie</span> @* Esto vendrá de la DB *@
                                    </div>
                                </div>
                            </div>

                            <div class="space-y-8">
                                <div>
                                    <h3 class="text-amber-500 font-black text-xs tracking-[0.3em] uppercase mb-4 flex items-center gap-2">
                                        <i class="fa-solid fa-medal text-amber-700"></i> @L["Label_Progression"]
                                    </h3>

                                    <div class="space-y-2 max-h-64 overflow-y-auto pr-2 custom-scrollbar">
                                        @foreach (var prog in SelectedClass.Progressions.OrderBy(p => p.Level))
                                        {
                                            <div class="flex items-start gap-4 p-4 bg-black/20 rounded-2xl border border-white/5 group hover:border-amber-500/30 transition-all">
                                                <div class="bg-amber-600 text-black font-black text-xs px-2 py-1 rounded-md mt-1">
                                                    @L["Label_LevelShort"] @prog.Level
                                                </div>
                                                @foreach (var feature in prog.Features)
                                                {
                                                    <div @onclick="() => InspectFeature(feature)"
                                                         class="flex-1 cursor-pointer group/item flex items-center justify-between bg-white/5 hover:bg-white/10 p-3 rounded-xl transition-all border border-transparent hover:border-amber-500/20">

                                                        <h4 class="text-white font-bold text-sm uppercase group-hover/item:text-amber-500 transition-colors">
                                                            @feature.Name
                                                        </h4>

                                                        <i class="fa-solid fa-circle-info text-amber-900/40 group-hover/item:text-amber-500 text-xs"></i>
                                                    </div>
                                                }

                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="mt-2 pt-4 border-t border-white/5 flex justify-end">
                                <button @onclick="Confirm"
                                        class="px-6 py-2 bg-lime-600 hover:bg-lime-500 text-black font-black rounded-[2rem] transition-all shadow-xl shadow-lime-900/20 flex items-center gap-4">
                                    <span class="uppercase tracking-widest">@L["Btn_ConfirmClass"]</span>
                                    <i class="fa-solid fa-bolt-lightning"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@if (FeatureInInspection != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 animate-in fade-in duration-200">
        <div class="absolute inset-0 bg-black/80 backdrop-blur-sm" @onclick="CloseInspection"></div>

        <div class="relative bg-slate-900 border border-amber-500/30 w-full max-w-lg rounded-[2.5rem] shadow-2xl overflow-hidden animate-in zoom-in-95 duration-200">
            <div class="p-8">
                <div class="flex justify-between items-start mb-6">
                    <div>
                        <span class="text-amber-700 font-black text-[10px] tracking-[0.3em] uppercase">Detalle de Habilidad</span>
                        <h3 class="text-3xl font-black text-white italic uppercase tracking-tighter">@FeatureInInspection.Name</h3>
                    </div>
                    <button @onclick="CloseInspection" class="text-slate-500 hover:text-white transition-colors">
                        <i class="fa-solid fa-circle-xmark text-2xl"></i>
                    </button>
                </div>
                <div class="mb-6">
                    @foreach (var modifier in FeatureInInspection.Modifiers)
                    {
                        @switch (modifier.Type)
                        {
                            case ModifierType.AttributeBonus:
                                <div class="flex items-center gap-4 bg-blue-900/20 border border-blue-500/30 p-4 rounded-2xl">
                                    <i class="fa-solid fa-up-long text-blue-500 text-2xl"></i>
                                    <div>
                                        <p class="text-blue-500 font-black text-xs uppercase">Mejora de Atributo</p>
                                        <p class="text-white font-bold text-xl">+@modifier.Value a @L[modifier.Target]</p>
                                    </div>
                                </div>
                                break;

                            case ModifierType.GrantSpell:
                                <div class="space-y-4">
                                    <div class="flex items-center gap-4 bg-purple-900/20 border border-purple-500/30 p-4 rounded-2xl">
                                        <i class="fa-solid fa-wand-sparkles text-purple-500 text-2xl"></i>
                                        <div>
                                            <p class="text-purple-500 font-black text-[10px] uppercase">@L["Label_GrantSpell"]</p>
                                            <p class="text-white font-bold text-xl">@modifier.Target</p>
                                        </div>
                                    </div>

                                    @if (IsLoadingSpell)
                                    {
                                        <div class="text-center p-4"><i class="fa-solid fa-spinner fa-spin text-amber-500"></i></div>
                                    }

                                    @foreach (var spell in InspectedSpells.Where(s => s.Name == modifier.Target))
                                    {
                                        <div class="bg-black/40 border border-purple-500/10 rounded-3xl p-5 mt-2 animate-in slide-in-from-top-2">
                                            <div class="grid grid-cols-2 gap-4 mb-3">
                                                <div>
                                                    <span class="block text-[9px] text-slate-500 uppercase font-black">@L["Label_CastingTime"]</span>
                                                    <span class="text-xs text-white">@spell.CastingTime</span>
                                                </div>
                                                <div>
                                                    <span class="block text-[9px] text-slate-500 uppercase font-black">@L["Label_Range"]</span>
                                                    <span class="text-xs text-white">@spell.Range</span>
                                                </div>
                                            </div>
                                            <p class="text-[11px] text-slate-400 font-serif leading-relaxed line-clamp-3">@spell.Description</p>
                                        </div>
                                    }
                                </div>
                                break;

                            case ModifierType.HpBonus:
                                <div class="flex items-center gap-4 bg-red-900/20 border border-red-500/30 p-4 rounded-2xl">
                                    <i class="fa-solid fa-heart-pulse text-red-500 text-2xl"></i>
                                    <div>
                                        <p class="text-red-500 font-black text-xs uppercase">Bono de Vitalidad</p>
                                        <p class="text-white font-bold text-xl">+@modifier.Value HP @L["Msg_PerLevel"]</p>
                                    </div>
                                </div>
                                break;

                            case ModifierType.GrantFeature:
                                <div class="flex items-center gap-4 bg-amber-900/20 border border-amber-500/30 p-4 rounded-2xl">
                                    <i class="fa-solid fa-book-skull text-amber-500 text-2xl"></i>
                                    <div>
                                        <p class="text-amber-500 font-black text-xs uppercase">Nueva Habilidad</p>
                                        <p class="text-white font-bold text-xl">@modifier.Value</p>
                                    </div>
                                </div>
                                break;
                        }
                    }

                </div>
                <div class="bg-black/40 p-6 rounded-3xl border border-white/5 max-h-[60vh] overflow-y-auto custom-scrollbar">
                    <p class="text-slate-300 font-serif leading-relaxed italic text-lg">
                        @FeatureInInspection.Description
                    </p>
                </div>

                <div class="mt-8 flex justify-end">
                    <button @onclick="CloseInspection" class="px-8 py-3 bg-amber-600 text-black font-black rounded-2xl hover:bg-amber-500 transition-all uppercase text-xs tracking-widest">
                        Entendido
                    </button>
                </div>
            </div>
        </div>
    </div>
}
@code {
    private List<ClassDefinition> Classes = new();
    private ClassDefinition? SelectedClass;
    private Feature? FeatureInInspection;
    private List<Spell> InspectedSpells = new();
    private bool IsLoadingSpell = false;

    private async Task InspectFeature(Feature feature)
    {
        FeatureInInspection = feature;
        InspectedSpells.Clear();

        var grantSpellModifiers = feature.Modifiers.Where(x => x.Type == ModifierType.GrantSpell).ToList();

        if (grantSpellModifiers.Any())
        {
            IsLoadingSpell = true;
            foreach (var mod in grantSpellModifiers)
            {
                var spell = await UnitOfWork.Spells.GetByNameAsync(mod.Target);
                if (spell != null)
                {
                    InspectedSpells.Add(spell);
                }
            }
            IsLoadingSpell = false;
        }
    }
    private void CloseInspection()
    { 
        FeatureInInspection = null; 
        InspectedSpells.Clear();
    }

    protected override async Task OnInitializedAsync()
    {
        Classes = (await UnitOfWork.ClassDefinitions.GetClassesWithFeatures()).ToList();
    }


    private void Back() => Navigation.NavigateTo("/character/create");

    private void Confirm()
    {
        if (SelectedClass != null)
        {
            CreationService.SelectedClassId = SelectedClass.Id;
            Navigation.NavigateTo("/character/create");
        }
    }
}
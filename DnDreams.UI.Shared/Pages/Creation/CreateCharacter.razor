@page "/character/create"
@using DnDreams.Application.Services.DtosServices
@using DnDreams.Application.DTOs
@using DnDreams.Application.Interfaces.DtosInterfaces
@inject IUnitOfWork UnitOfWork
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L
@inject CharacterCreationService CreationService
@inject IService<RaceDto,Race> RaceService
@inject IService<ClassDefinitionDto,ClassDefinition> ClassService
@inject IService<BackgroundDto,Background> BackgroundService

<div class="min-h-screen bg-black p-6">
    <div class="max-w-5xl mx-auto">

        <div class="mb-8 flex justify-between items-end">
            <div>
                <button @onclick='Back' class="text-amber-700 hover:text-amber-500 text-[10px] font-black tracking-widest mb-4 uppercase flex items-center gap-2 transition-colors">
                    <i class="fa-solid fa-arrow-left"></i> @L["Btn_Back"]
                </button>
                <h1 class="text-5xl font-black text-amber-500 italic uppercase">@L["Title_NewHero"]</h1>
                <p class="text-slate-500 font-serif italic text-lg">@L["Title_StepIdentity"]</p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <div class="lg:col-span-2 space-y-6">
                <div class="bg-slate-900 border border-amber-900/20 rounded-[2.5rem] p-8 shadow-2xl">
                    <div class="space-y-6">
                        <div>
                            <label class="block text-amber-700 font-black text-[10px] tracking-widest mb-3 uppercase">@L["Label_HeroName"]</label>
                            <input @bind="CreationService.Name" placeholder="@L["Placeholder_Name"]"
                                   class="w-full bg-black/40 border border-amber-900/20 p-4 rounded-2xl text-white text-xl font-bold focus:border-amber-500 outline-none transition-all" />
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div @onclick='() => NavigateTo("/character/create/class")'
                                 class="cursor-pointer bg-black/40 border border-amber-900/20 p-4 rounded-2xl flex justify-between items-center">
                                <div>
                                    <label class="block text-amber-700 font-black text-[10px] uppercase">@L["Label_Class"]</label>
                                    <span class="text-white font-bold">
                                        @(selectedClass?.Name ?? L["Choose_Class"])
                                    </span>
                                </div>
                                <i class="fa-solid fa-chevron-right text-amber-500"></i>
                            </div>

                            <div @onclick='() => NavigateTo("/character/create/race")'
                                 class="cursor-pointer bg-black/40 border border-amber-900/20 p-4 rounded-2xl flex justify-between items-center">
                                <div>
                                    <label class="block text-amber-700 font-black text-[10px] uppercase">@L["Label_Race"]</label>
                                    <span class="text-white font-bold">
                                        @(selectedRace?.Name ?? L["Choose_Race"])
                                    </span>
                                </div>
                                <i class="fa-solid fa-chevron-right text-amber-500"></i>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div @onclick='() => NavigateTo("/character/create/background")'
                                 class="cursor-pointer bg-black/40 border border-amber-900/20 p-4 rounded-2xl flex justify-between items-center">
                                <div>
                                    <label class="block text-amber-700 font-black text-[10px] uppercase">@L["Label_Background"]</label>
                                    <span class="text-white font-bold">
                                        @(selectedBackground?.Name ?? L["Choose_Background"])
                                    </span>
                                </div>
                                <i class="fa-solid fa-chevron-right text-amber-500"></i>
                            </div>
                        </div>

                        <div>
                            <label class="block text-amber-700 font-black text-[10px] tracking-widest mb-3 uppercase">@L["Label_History"]</label>
                            <textarea @bind="CreationService.History" rows="4" placeholder="@L["Placeholder_History"]"
                                      class="w-full bg-black/40 border border-amber-900/20 p-4 rounded-2xl text-slate-300 font-serif outline-none focus:border-amber-500 transition-all resize-none"></textarea>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end">
                    <button @onclick="HandleCreate"
                            disabled="@(!IsFormReady())"
                            class="px-12 py-5 bg-lime-600 hover:bg-lime-500 text-black font-black rounded-2xl transition-all shadow-xl shadow-lime-900/20 disabled:opacity-10 disabled:grayscale uppercase tracking-tighter flex items-center gap-3">
                        @L["Btn_CreateHero"] <i class="fa-solid fa-wand-sparkles"></i>
                    </button>
                </div>
            </div>

            <div class="lg:col-span-1">
                <div class="bg-slate-900 border border-amber-900/30 rounded-[2.5rem] p-6 sticky top-6 shadow-2xl flex flex-col gap-4 max-h-[calc(100vh-3rem)]">

                    <h3 class="text-amber-500 font-black text-sm italic uppercase tracking-widest border-b border-amber-900/20 pb-2 shrink-0">
                        @L["Label_SelectionDetails"]
                    </h3>

                    @if (selectedRace == null && selectedClass == null && selectedBackground == null)
                    {
                        <div class="flex flex-col items-center justify-center h-64 text-center my-auto">
                            <i class="fa-solid fa-book-sparkles text-amber-900/20 text-5xl mb-4"></i>
                            <p class="text-slate-600 font-serif italic text-sm px-4">@L["Msg_EmptySelection"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="flex-1 min-h-[150px] max-h-[320px] overflow-y-auto pr-1 custom-scrollbar space-y-3">
                            @if (selectedRace != null)
                            {
                                <div class="p-3 bg-black/30 rounded-2xl border border-slate-800/60 animate-in slide-in-from-bottom-2 duration-200">
                                    <span class="text-[9px] font-black text-amber-700 uppercase tracking-wider">@L["Label_Race"]</span>
                                    <h4 class="text-sm font-bold text-white mb-1 uppercase tracking-wide">@selectedRace.Name</h4>
                                    <p class="text-slate-400 text-[11px] font-sans leading-relaxed line-clamp-3">@((MarkupString)selectedRace.Description)</p>
                                </div>
                            }

                            @if (selectedClass != null)
                            {
                                <div class="p-3 bg-black/30 rounded-2xl border border-slate-800/60 animate-in slide-in-from-bottom-2 duration-200">
                                    <span class="text-[9px] font-black text-amber-700 uppercase tracking-wider">@L["Label_Class"]</span>
                                    <h4 class="text-sm font-bold text-white mb-1 uppercase tracking-wide">@selectedClass.Name</h4>
                                    <p class="text-slate-400 text-[11px] font-sans leading-relaxed line-clamp-3">@((MarkupString)selectedClass.Description)</p>
                                </div>
                            }

                            @if (selectedBackground != null)
                            {
                                <div class="p-3 bg-black/30 rounded-2xl border border-slate-800/60 animate-in slide-in-from-bottom-2 duration-200">
                                    <span class="text-[9px] font-black text-amber-700 uppercase tracking-wider">@L["Label_Background"]</span>
                                    <h4 class="text-sm font-bold text-white mb-1 uppercase tracking-wide">@selectedBackground.Name</h4>
                                    <p class="text-slate-400 text-[11px] font-sans leading-relaxed line-clamp-3">@((MarkupString)selectedBackground.Description)</p>
                                </div>
                            }
                        </div>

                        <div class="shrink-0 p-3.5 bg-amber-500/5 rounded-2xl border border-amber-500/10 space-y-2">
                            <h4 class="text-[10px] font-bold text-amber-500 uppercase tracking-widest">
                                @L["Background_Bonus"]
                            </h4>
                            <p class="text-[11px] text-slate-300 font-sans leading-relaxed">
                                @L["BackgroundASI_HelpText"] <span class="text-amber-400 font-semibold">@selectedBackground?.Name</span>:
                            </p>
                            <div class="flex flex-wrap gap-1.5">
                                @if (selectedBackground != null)
                                {
                                    @foreach (var allowedAsi in selectedBackground.ASIs)
                                    {
                                        <span class="text-[9px] font-mono font-bold bg-slate-950 border border-slate-800 text-slate-300 px-2 py-0.5 rounded uppercase tracking-wider">
                                            @L[allowedAsi.ToString()]
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private List<RaceDto> races = [];
    private List<ClassDefinitionDto> classes = [];
    private List<BackgroundDto> backgrounds = [];

    private RaceDto? selectedRace;
    private ClassDefinitionDto? selectedClass;
    private BackgroundDto? selectedBackground;

    protected override async Task OnInitializedAsync()
    {
        races = await RaceService.GetAllAsync(null, null);
        classes = await ClassService.GetAllAsync(null, null);
        backgrounds = await BackgroundService.GetAllAsync(null, null);
    }

    // 🚨 Asegura el bindeado de los textos antes de saltar a otra sub-pantalla
    private void NavigateTo(string path)
    {
        Navigation.NavigateTo(path);
    }

    private bool IsFormReady() =>
        !string.IsNullOrWhiteSpace(CreationService.Name) &&
        CreationService.SelectedRaceId.HasValue &&
        CreationService.SelectedClassId.HasValue &&
        CreationService.SelectedBackgroundId.HasValue;

    private void Back() => Navigation.NavigateTo("/characters");

    private async Task HandleCreate()
    {
        if (!IsFormReady()) return;
        Navigation.NavigateTo("/character/create/abilities");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CreationService.SelectedRaceId.HasValue)
        {
            selectedRace = await RaceService.GetByIdAsync(CreationService.SelectedRaceId.Value);
        }

        if (CreationService.SelectedClassId.HasValue)
        {
            selectedClass = await ClassService.GetByIdAsync(CreationService.SelectedClassId.Value);
        }

        if (CreationService.SelectedBackgroundId.HasValue)
        {
            selectedBackground = await BackgroundService.GetByIdAsync(CreationService.SelectedBackgroundId.Value);
        }
    }
}
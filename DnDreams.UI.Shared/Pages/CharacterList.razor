@page "/characters"
@using DnDreams.Application.DTOs
@using DnDreams.Application.Interfaces.DtosInterfaces
@using DnDreams.Domain.Entities
@inject IService<CharacterDto, Character> CharacterService
@inject NavigationManager Navigation
@inject IStringLocalizer<AppStrings> L

<div class="p-4 md:p-6 max-w-7xl mx-auto min-h-screen bg-black">
    <div class="flex justify-between items-center mb-10">
        <div>
            <h1 class="text-4xl font-black text-amber-500 tracking-tighter italic uppercase">@L["Title_MyAdventurers"]</h1>
            <div class="h-1 w-20 bg-amber-600 mt-1 rounded-full"></div>
        </div>
    </div>

    @if (Characters == null)
    {
        <div class="flex flex-col items-center justify-center py-20">
            <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-amber-500 mb-4"></div>
            <p class="text-amber-500/50 font-serif italic text-sm">@L["Msg_CheckingTavernLogs"]</p>
        </div>
    }
    else if (!Characters.Any())
    {
        <div class="bg-slate-900 border-2 border-dashed border-amber-900/30 p-12 md:p-20 rounded-[2.5rem] text-center max-w-2xl mx-auto">
            <i class="fa-solid fa-scroll text-5xl text-amber-900/20 mb-4"></i>
            <p class="text-slate-400 text-base font-serif italic leading-relaxed">@L["Msg_EmptyTavernHelp"]</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var p in Characters)
            {
                <div class="bg-slate-900 border border-amber-900/20 rounded-[2rem] overflow-hidden hover:border-amber-500/40 transition-all duration-300 group shadow-[0_20px_50px_rgba(0,0,0,0.6)] relative flex flex-col justify-between">

                    <div class="absolute top-0 right-0 w-16 h-16 bg-amber-500/5 rotate-45 translate-x-8 -translate-y-8 border-b border-amber-500/20 pointer-events-none"></div>

                    <div class="p-6 pb-0">
                        <div class="flex justify-between items-start gap-3 mb-5">
                            <div class="min-w-0">
                                <h3 class="text-xl font-black text-amber-500 group-hover:text-amber-400 transition-colors tracking-tight truncate uppercase">@p.Name</h3>
                                <span class="text-[10px] font-mono font-black text-slate-400 tracking-wider uppercase block truncate mt-0.5">
                                    @(p.ClassDef?.Name ?? "[No Class]")
                                </span>
                            </div>
                            <div class="bg-black/40 border border-amber-500/20 px-3 py-1.5 rounded-xl text-center shrink-0">
                                <span class="text-[8px] text-amber-600 font-mono font-black block leading-none mb-1">@L["Label_LevelShort"]</span>
                                <span class="text-xl font-black text-white leading-none font-mono">@p.Level</span>
                            </div>
                        </div>

                        <div class="grid grid-cols-3 gap-2 mb-6">
                            @DisplayStat("STR", p.Strength, p.StrModifier)
                            @DisplayStat("DEX", p.Dexterity, p.DexModifier)
                            @DisplayStat("CON", p.Constitution, p.ConModifier)
                            @DisplayStat("INT", p.Intelligence, p.IntModifier)
                            @DisplayStat("WIS", p.Wisdom, p.WisModifier)
                            @DisplayStat("CHA", p.Charisma, p.ChaModifier)
                        </div>
                    </div>

                    <div class="p-6 pt-0 mt-auto">
                        <div class="flex gap-3">
                            <button @onclick="() => NavigateToSheet(p.Id)"
                                    class="flex-1 py-3.5 bg-black border border-amber-900/40 text-amber-500 text-xs font-black rounded-xl hover:bg-amber-900/20 transition-all flex items-center justify-center gap-2 active:scale-[0.97] uppercase tracking-wide">
                                <i class="fa-solid fa-eye opacity-60"></i> @L["Btn_ViewSheet"]
                            </button>

                            <button @onclick="() => NavigateToLevelUp(p.Id)"
                                    class="px-5 py-3.5 bg-lime-600 text-black rounded-xl hover:bg-lime-500 transition-all shadow-md shadow-lime-900/20 active:scale-[0.97] group">
                                <i class="fa-solid fa-arrow-up group-hover:-translate-y-0.5 transition-transform"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    // 🚨 CAMBIO: Ahora consumimos DTOs desacoplados en lugar de entidades de dominio puras
    private List<CharacterDto>? Characters;

    protected override async Task OnInitializedAsync()
    {
        await LoadCharacters();
    }

    private async Task LoadCharacters()
    {
        Characters = await CharacterService.GetAllAsync(null, null);
    }

    private void NavigateToLevelUp(Guid id) => Navigation.NavigateTo($"/character/{id}/levelup");
    private void NavigateToSheet(Guid id) => Navigation.NavigateTo($"/character/{id}");

    private RenderFragment DisplayStat(string label, int value, int modifier) => __builder =>
    {
        <div class="bg-black/30 border border-amber-900/10 p-2 rounded-xl text-center hover:border-amber-500/20 transition-colors">
            <span class="text-[8px] font-mono font-black text-amber-700 block mb-0.5 tracking-wider">@label</span>
            <div class="text-white font-black text-sm font-mono">@value</div>
            <div class="text-[9px] font-mono font-bold mt-0.5 @(modifier >= 0 ? "text-lime-500" : "text-red-500")">
                @(modifier >= 0 ? "+" : "")@modifier
            </div>
        </div>
    };
}
@page "/"
@inject IUnitOfWork UnitOfWork
@inject NavigationManager Navigation

<div class="p-6">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-black text-white">Mis Aventureros</h1>
        
    </div>

    @if (Characters == null)
    {
        <p class="text-slate-400">Cargando taberna...</p>
    }
    else if (!Characters.Any())
    {
        <div class="bg-slate-900 border border-dashed border-slate-700 p-10 rounded-3xl text-center">
            <p class="text-slate-500">Parece que no hay nadie aquí. ¡Importa tu Excel!</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var p in Characters)
            {
                <div class="bg-slate-900 border border-slate-800 p-6 rounded-3xl hover:border-lime-500 transition-all group">
                    <h3 class="text-xl font-bold text-white mb-1">@p.Name</h3>
                    <p class="text-lime-400 text-sm mb-4">@p.ClassDef?.Name Nivel @p.Level</p>
                    
                    <div class="flex gap-3">
                        <button @onclick="() => NavigateToLevelUp(p.Id)"
                                class="flex-1 py-2 bg-slate-800 text-white rounded-xl font-bold hover:bg-slate-700 transition-colors">
                            Ver Ficha
                        </button>
                        
                            <button @onclick="() => NavigateToLevelUp(p.Id)"
                                class="px-4 py-2 bg-lime-600 text-black rounded-xl font-black hover:bg-lime-500 transition-all">
                            <i class="fa-solid fa-arrow-up"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IEnumerable<Character>? Characters;

    protected override async Task OnInitializedAsync()
    {
        await LoadCharacters();
    }

    private async Task LoadCharacters()
    {
        Characters = await UnitOfWork.Characters.GetAllWithDetailsAsync();
    }

    private async Task ImportData()
    {
        // Aquí deberías llamar a tu lógica de abrir archivo o usar una ruta fija para pruebas
        // var success = await ImportManager.ImportFromExcelAsync("Ruta_A_Tu_Archivo.xlsx");
        // if(success) await LoadCharacters();
    }

     private void NavigateToLevelUp(System.Guid id)
    {
        Navigation.NavigateTo($"/character/{id}/levelup");
    }
}
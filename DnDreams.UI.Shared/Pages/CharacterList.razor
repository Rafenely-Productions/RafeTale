@page "/characters"
@using DnDreams.Domain.Entities
@using DnDreams.Domain.Interfaces
@inject IUnitOfWork UnitOfWork
@inject NavigationManager Navigation

<div class="p-6 max-w-7xl mx-auto min-h-screen bg-black">
    <div class="flex justify-between items-center mb-10">
        <div>
            <h1 class="text-4xl font-black text-amber-500 tracking-tighter italic uppercase">Mis Aventureros</h1>
            <div class="h-1 w-20 bg-amber-600 mt-1 rounded-full"></div>
        </div>
    </div>

    @if (Characters == null)
    {
        <div class="flex flex-col items-center justify-center py-20">
            <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-amber-500 mb-4"></div>
            <p class="text-amber-500/50 font-serif italic">Consultando los archivos de la taberna...</p>
        </div>
    }
    else if (!Characters.Any())
    {
        <div class="bg-slate-900 border-2 border-dashed border-amber-900/30 p-20 rounded-[2rem] text-center">
            <i class="fa-solid fa-scroll text-5xl text-amber-900/20 mb-4"></i>
            <p class="text-slate-500 text-lg font-serif italic">Nadie ha llegado a la posada aún. ¡Importa tu Excel!</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var p in Characters)
            {
                <div class="bg-slate-900 border border-amber-900/20 rounded-[2rem] overflow-hidden hover:border-amber-500/50 transition-all duration-500 group shadow-[0_20px_50px_rgba(0,0,0,0.5)] relative">

                    <div class="absolute top-0 right-0 w-16 h-16 bg-amber-500/5 rotate-45 translate-x-8 -translate-y-8 border-b border-amber-500/20"></div>

                    <div class="p-8 pb-0">
                        <div class="flex justify-between items-start mb-6">
                            <div>
                                <h3 class="text-2xl font-black text-amber-500 group-hover:text-amber-400 transition-colors tracking-tight">@p.Name.ToUpper()</h3>
                                <span class="text-xs font-black text-slate-400 tracking-[0.2em] uppercase">
                                    @p.ClassDef?.Name
                                </span>
                            </div>
                            <div class="bg-black/40 border border-amber-500/20 px-4 py-2 rounded-2xl text-center">
                                <span class="text-[10px] text-amber-600 font-black block leading-none mb-1">NIVEL</span>
                                <span class="text-2xl font-black text-white leading-none">@p.Level</span>
                            </div>
                        </div>

                        <div class="grid grid-cols-3 gap-3 mb-8">
                            @DisplayStat("STR", p.Strength, p.StrModifier)
                            @DisplayStat("DEX", p.Dexterity, p.DexModifier)
                            @DisplayStat("CON", p.Constitution, p.ConModifier)
                            @DisplayStat("INT", p.Intelligence, p.IntModifier)
                            @DisplayStat("WIS", p.Wisdom, p.WisModifier)
                            @DisplayStat("CHA", p.Charisma, p.ChaModifier)
                        </div>
                    </div>

                    <div class="p-8 pt-0 mt-auto">
                        <div class="flex gap-4">
                            <button @onclick="() => NavigateToSheet(p.Id)"
                                    class="flex-1 py-4 bg-black border border-amber-900/40 text-amber-500 rounded-2xl font-bold hover:bg-amber-900/20 transition-all flex items-center justify-center gap-3 active:scale-95">
                                <i class="fa-solid fa-eye text-sm opacity-50"></i> VER FICHA
                            </button>

                            <button @onclick="() => NavigateToLevelUp(p.Id)"
                                    class="px-6 py-4 bg-lime-600 text-black rounded-2xl font-black hover:bg-lime-500 transition-all shadow-[0_10px_20px_rgba(77,124,15,0.3)] active:scale-95 group">
                                <i class="fa-solid fa-arrow-up group-hover:-translate-y-1 transition-transform"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IEnumerable<Character>? Characters;

    protected override async Task OnInitializedAsync()
    {
        await LoadCharacters();
    }

    private async Task LoadCharacters()
    {
        Characters = await UnitOfWork.Characters.GetAllWithDetailsAsync();
    }

    private void NavigateToLevelUp(Guid id) => Navigation.NavigateTo($"/character/{id}/levelup");
    private void NavigateToSheet(Guid id) => Navigation.NavigateTo($"/character/{id}");

    private RenderFragment DisplayStat(string label, int value, int modifier) => __builder =>
    {
        <div class="bg-black/30 border border-amber-900/10 p-3 rounded-2xl text-center hover:border-amber-500/20 transition-colors">
            <span class="text-[9px] font-black text-amber-700 block mb-1 tracking-widest">@label</span>
            <div class="text-white font-black text-base">@value</div>
            <div class="text-[10px] @(modifier >= 0 ? "text-lime-500" : "text-red-500") font-bold mt-1">
                @(modifier >= 0 ? "+" : "")@modifier
            </div>
        </div>
    };
}
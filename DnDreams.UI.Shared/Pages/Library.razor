@page "/library"
@using DnDreams.Domain.Enums
@using DnDreams.Domain.Entities
@using DnDreams.Application.DTOs
@using DnDreams.Application.Interfaces.DtosInterfaces
@using DnDreams.Domain.Interfaces
@using DnDreams.UI.Shared.Components.Library
@inject IUnitOfWork UnitOfWork
@inject IService<ClassDefinitionDto, ClassDefinition> ClassService
@inject IService<SubclassDto, Subclass> SubclassService
@inject IService<RaceDto, Race> RaceService
@inject IService<SpellDto, Spell> SpellService
@inject IService<BackgroundDto, Background> BackgroundService
@inject IService<FeatDto, Feat> FeatService
@inject IStringLocalizer<AppStrings> L
@inject IStringLocalizer<LibraryStrings> LL
@inject IJSRuntime JS

<div @ref="containerRef" class="w-full max-w-7xl mx-auto px-2 sm:px-4 py-2 text-white h-auto min-h-fit">
    @if (SelectedTab == CodexKey.None)
    {
        <LibraryGrid ClassesCount="Classes.Count"
                     RacesCount="Races.Count"
                     SpellsCount="TotalSpellsCount"
                     BackgroundsCount="totalBackgroundsCount"
                     FeatsCount="Feats.Count"
                     OnTabSelected="NavigateToTab" />
    }
    else
    {

            <div class="absolute left-0 z-50">
                <LibraryNavigationBar IsAtRoot="false"
                                      IsInspecting="IsCurrentlyInspecting()"
                                      OnBackToLibrary="HandleBackAction"
                                      OnReturnFromChild="HandleBackActionFromChildren" />
            </div>
        <div class="relative rounded-xl border border-slate-800 bg-slate-900/60 p-3 sm:p-6 shadow-2xl h-auto pt-14">
            <div class="w-full">
                @switch (SelectedTab)
                {
                    case CodexKey.Classes:
                        if (InspectedClass == null)
                        {
                            <ClassList Classes="Classes" OnClassSelected="InspectClass" />
                        }
                        else
                        {
                            <ClassInspector InspectedClass="InspectedClass" />
                        }
                        break;
                    case CodexKey.Races:
                        @if (InspectedRace == null)
                        {
                            <RaceList Races="Races"
                                      OnInspectedRace="InspectRace"
                                      InitialScrollPosition="savedScrollPosition" />
                        }
                        else
                        {
                            <RaceInspector RaceDto="InspectedRace" />
                        }
                        break;
                    case CodexKey.Spells:
                        <SpellList AllSpells="AllSpells" />
                        break;
                    case CodexKey.Backgrounds:
                        @if (InspectedBackground == null)
                        {
                            <BackgroundList Backgrounds="backgrounds" OnInspectedBackground="InspectBackground" InitialScrollPosition="savedScrollPosition" />
                        }
                        else
                        {
                            <BackgroundInspector BackgroundDto="InspectedBackground" />
                        }
                        break;
                    case CodexKey.Feats:
                        @if (InspectedFeat == null)
                        {
                            <FeatList Feats="Feats"
                                      OnInspectedFeat="InspectFeat"
                                      InitialScrollPosition="savedScrollPosition" />
                        }
                        else
                        {
                            <FeatInspector FeatDto="InspectedFeat" />
                        }
                        break;
                    case CodexKey.Rules:
                        <div class="w-full max-w-full overflow-hidden">
                            <h2 class="text-2xl font-black mb-4 uppercase italic text-amber-500">@LL["Character_Advancement"]</h2>
                            <div class="w-full overflow-x-auto custom-scrollbar pb-2">
                                <table class="w-full text-left text-sm">
                                    <thead>
                                        <tr class="border-b border-slate-800 text-xs uppercase tracking-wider text-slate-400 font-black">
                                            <th class="px-3 py-3">@LL["Table_Level"]</th>
                                            <th class="px-3 py-3">@LL["Table_XpRequired"]</th>
                                            <th class="px-3 py-3 max-w-[130px] leading-tight break-words">
                                                @LL["Table_ProficiencyBonus"]
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in XpProgressionTable)
                                        {
                                            <tr class="border-b border-slate-800/40 hover:bg-white/5 transition-colors">
                                                <td class="px-3 py-3 font-mono font-bold text-amber-500">@row.Level</td>
                                                <td class="px-3 py-3 text-white">@row.Xp.ToString("N0") XP</td>
                                                <td class="px-3 py-3 font-mono text-slate-400">+@row.Proficiency</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        break;
                    default:
                        break;
                }
            </div>
        </div>
    }
</div>

@code {
    private ElementReference containerRef;

    private CodexKey SelectedTab = CodexKey.None;
    private double savedScrollPosition = 0;
    private double savedLibScrollPosition = 0;

    private ClassDefinitionDto? InspectedClass;
    private RaceDto? InspectedRace;
    private BackgroundDto? InspectedBackground;
    private FeatDto? InspectedFeat;

    private List<ClassDefinitionDto> Classes = [];
    private List<RaceDto> Races = [];
    private List<SpellDto> AllSpells = [];
    private List<FeatDto> Feats = [];
    private int TotalSpellsCount = 0;

    private List<(int Level, int Xp, int Proficiency)> XpProgressionTable = [];
    private int totalBackgroundsCount;
    private List<BackgroundDto> backgrounds = new();

    private bool IsCurrentlyInspecting() => InspectedClass != null || InspectedRace != null || InspectedBackground != null || InspectedFeat != null;

    protected override async Task OnInitializedAsync()
    {
        Classes = await ClassService.GetAllAsync(null, null);
        Races = await RaceService.GetAllAsync(null, includes: query => query.Include(x => x.Languages).IncludeCollection(x => x.SubRaces, z => z.Traits).Include(x => x.Traits));
        AllSpells = await SpellService.GetAllAsync(null);
        TotalSpellsCount = AllSpells.Count;
        Feats = await FeatService.GetAllAsync(null, null);
        backgrounds = await BackgroundService.GetAllAsync(null, null);
        totalBackgroundsCount = backgrounds.Count;
        LoadXpProgressionRules();
    }

    private async Task NavigateToTab(CodexKey key)
    {
        StateHasChanged();

        if (SelectedTab == CodexKey.None)
        {
            try
            {
                savedLibScrollPosition = await JS.InvokeAsync<double>("eval", "document.getElementById('main-scroll-view')?.scrollTop || 0");
            }
            catch { }
        }

        SelectedTab = key;

        if (key != CodexKey.None)
        {
            await ClearInspectionsAndScrollTop();

            if (key == CodexKey.Rules)
                await ScrollTop();
        }
        else
        {
            //await Task.Delay(1);
            try
            {
                await JS.InvokeVoidAsync("eval", $"document.getElementById('main-scroll-view')?.scrollTo({{ top: {savedLibScrollPosition}, behavior: 'instant' }});");
            }
            catch { }
        }
    }

    private async Task InspectBackground(BackgroundDto bg) => await InspectItem(() => InspectedBackground = bg);
    private async Task InspectClass(ClassDefinitionDto bg) => await InspectItem(() => InspectedClass = bg);
    private async Task InspectRace(RaceDto bg) => await InspectItem(() => InspectedRace = bg);
    private async Task InspectFeat(FeatDto bg) => await InspectItem(() => InspectedFeat = bg);

    private async Task InspectItem(Action inspectionAction)
    {
        try
        {
            savedScrollPosition = await JS.InvokeAsync<double>("eval", "document.getElementById('main-scroll-view')?.scrollTop || 0");
        }
        catch { }

        inspectionAction();
    }

    private async Task HandleBackAction()
    {
        if (IsCurrentlyInspecting())
        {
            InspectedClass = null;
            InspectedRace = null;
            InspectedBackground = null;
            InspectedFeat = null;

            try
            {
                await JS.InvokeVoidAsync("eval", $"document.getElementById('main-scroll-view')?.scrollTo({{ top: {savedScrollPosition}, behavior: 'instant' }});");
            }
            catch { }
        }
        else
        {
            await NavigateToTab(CodexKey.None);
        }
    }

    private async Task HandleBackActionFromChildren()
    {
        if (IsCurrentlyInspecting())
        {
            InspectedClass = null;
            InspectedRace = null;
            InspectedBackground = null;
            InspectedFeat = null;

            try
            {
                await JS.InvokeVoidAsync("eval", $"document.getElementById('main-scroll-view')?.scrollTo({{ top: {savedScrollPosition}, behavior: 'instant' }});");
            }
            catch { }
        }
        else
        {
            await NavigateToTab(CodexKey.None);
        }
    }


    private async Task ClearInspectionsAndScrollTop()
    {
        InspectedClass = null;
        InspectedRace = null;
        InspectedBackground = null;
        InspectedFeat = null;

        savedScrollPosition = 0;

        await ScrollTop();

        StateHasChanged();
    }

    private async Task ScrollTop()
    {
        try
        {
            //await JS.InvokeVoidAsync("eval", "document.getElementById('main-scroll-view')?.scrollTo({ top: 0, behavior: 'instant' });");
        }
        catch { }
    }

    private void LoadXpProgressionRules()
    {
        XpProgressionTable = new()
        {
            (1, 0, 2), (2, 300, 2), (3, 900, 2), (4, 2700, 2),
            (5, 6500, 3), (6, 14000, 3), (7, 23000, 3), (8, 34000, 3),
            (9, 48000, 4), (10, 64000, 4), (11, 85000, 4), (12, 100000, 4),
            (13, 120000, 5), (14, 140000, 5), (15, 165000, 5), (16, 195000, 5),
            (17, 225000, 6), (18, 265000, 6), (19, 305000, 6), (20, 355000, 6)
        };
    }
}
@namespace DnDreams.UI.Shared.Shared
@inherits LayoutComponentBase
@using DnDreams.Application.Services.Importer.Initializer
@inject IAppInitializer Initializer

<div class="min-h-screen bg-black text-slate-100 flex flex-col selection:bg-amber-500/30">
    @if (!Initializer.IsDatabaseReady)
    {
        <div class="fixed inset-0 bg-black flex flex-col justify-center items-center z-50 p-6">
            <div class="loading-wrapper text-center space-y-4">
                <img src="images/logo.svg" class="loading-logo size-20 mx-auto" alt="Logo DnDreams" />
                <div class="loading-text-glow font-mono text-xs tracking-widest uppercase text-amber-500 mt-2">
                    @Initializer.CurrentStatusMessage
                </div>
            </div>
        </div>
    }
    else
    {
        <header class="sticky top-0 z-50 bg-black/90 backdrop-blur-md border-b border-amber-900/20">
            <NavMenu />
        </header>

        <main class="flex-1 p-4 md:p-6 overflow-y-auto">
            @Body
        </main>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Initializer.OnInitializationCompleted += HandleInitializationCompleted;
        Initializer.OnStatusMessageChanged += HandleStatusMessageChanged;
    }

    private void HandleStatusMessageChanged(string newMessage) => InvokeAsync(StateHasChanged);
    private void HandleInitializationCompleted() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Initializer.OnInitializationCompleted -= HandleInitializationCompleted;
        Initializer.OnStatusMessageChanged -= HandleStatusMessageChanged;
    }
}
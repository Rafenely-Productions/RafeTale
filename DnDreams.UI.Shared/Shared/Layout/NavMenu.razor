@namespace DnDreams.UI.Shared.Shared

<div class="w-full flex items-center justify-between px-5 py-4 bg-slate-950 border-b border-amber-900/30">
    <NavLink class="flex items-center gap-3 " href="/">
        <div class="size-8 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-500 font-black text-xs font-mono shadow-inner">
            D&D
        </div>
        <span class="text-sm font-black text-amber-500 uppercase tracking-widest font-mono italic">DnDreams</span>
    </NavLink>

    <div class="flex items-center gap-3">
        <NavLink class="px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider text-slate-400 hover:text-white transition-all [&.active]:bg-amber-500 [&.active]:text-black [&.active]:shadow-lg [&.active]:shadow-amber-500/20" href="/characters" Match="NavLinkMatch.All">
            Personajes
        </NavLink>

        <NavLink class="px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider text-slate-400 hover:text-white transition-all [&.active]:bg-amber-500 [&.active]:text-black [&.active]:shadow-lg [&.active]:shadow-amber-500/20" href="/library">
            Librería
        </NavLink>
    </div>
</div>
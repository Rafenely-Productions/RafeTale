@using DnDreams.Application.DTOs
@using DnDreams.Application.Interfaces.DtosInterfaces
@using DnDreams.UI.Shared.Components.UI
@inject IStringLocalizer<AppStrings> L
@inject ISpellServiceSystem SpellService
@inject IService<CharacterDto, Character> CharacterService

<div class="space-y-4">
    @if (CharDto.SpellSlots != null && CharDto.SpellSlots.Any())
    {
        <div class="bg-slate-900 border border-amber-900/20 rounded-2xl p-4 shadow-xl space-y-3">
            <div class="flex justify-between items-center border-b border-amber-900/10 pb-2.5">
                <h3 class="text-amber-500 font-black text-xs uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-wand-sparkles text-amber-700"></i> @L["Title_SpellSlots"]
                </h3>
                <button @onclick="TriggerLongRest" class="px-2.5 py-1 text-[10px] font-black bg-amber-500/10 text-amber-400 hover:bg-amber-500 hover:text-black border border-amber-500/20 rounded-xl transition-all uppercase tracking-wider flex items-center gap-1">
                    <i class="fa-solid fa-bed"></i> @L["Btn_LongRest"]
                </button>
            </div>

            <div class="space-y-2">
                @foreach (var slot in CharDto.SpellSlots.Where(s => s.Level > 0).OrderBy(s => s.Level))
                {
                    <div class="bg-black/40 border border-slate-800/80 p-2.5 rounded-xl flex flex-col gap-1.5">
                        <div class="flex justify-between items-center text-xs">
                            <span class="font-bold text-slate-200 text-[11px]">@L["Label_SlotLevel"] @slot.Level</span>
                            <span class="font-mono text-[10px] text-amber-400 font-black bg-black/60 px-2 py-0.5 rounded">@slot.RemainingSlots / @slot.MaxSlots</span>
                        </div>
                        <div class="flex flex-wrap gap-1">
                            @for (int i = 0; i < slot.MaxSlots; i++)
                            {
                                bool isUsed = i < slot.UsedSlots;
                                <div class="size-3 rounded-full border @(isUsed ? "bg-slate-950 border-slate-700" : "bg-cyan-400 border-cyan-300 shadow-[0_0_6px_rgba(34,211,238,0.5)]")"></div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="bg-slate-900 border border-amber-900/20 rounded-2xl p-4 shadow-xl space-y-3">
        <h3 class="text-amber-500 font-black text-xs uppercase tracking-wider flex items-center gap-2 border-b border-amber-900/10 pb-2.5">
            <i class="fa-solid fa-book-sparkles text-amber-700"></i> @L["Title_Spellbook"]
        </h3>
        <div class="space-y-2 max-h-[50vh] overflow-y-auto pr-1">
            @if (CharDto.KnownSpells == null || !CharDto.KnownSpells.Any())
            {
                <EmptyState IconClass="fa-book-skull"
                            Title="@L["EmptyState_NoSpells_Title"]"
                            Description="@L["EmptyState_NoSpells_Desc"]" />
            }
            else
            {
                @foreach (var spell in CharDto.KnownSpells)
                {
                    <SpellRow Spell="spell"
                              CanCast="HasSlotsAvailable((int)spell.Level)"
                              OnInspect="() => OnInspectSpell.InvokeAsync(spell)"
                              OnCast="() => CastSpell((int)spell.Level, (int)spell.Level)" />
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public CharacterDto CharDto { get; set; } = null!;
    [Parameter] public EventCallback<SpellDto> OnInspectSpell { get; set; }
    [Parameter] public EventCallback OnCharacterUpdated { get; set; }

    private bool HasSlotsAvailable(int slotLevel)
    {
        if (slotLevel == 0) return true;
        var slot = CharDto.SpellSlots?.FirstOrDefault(s => s.Level == slotLevel);
        return slot != null && slot.RemainingSlots > 0;
    }

    private async Task TriggerLongRest()
    {
        await SpellService.RestRestoreSlotsAsync(CharDto.Id);
        await RefreshCharacterAsync();
    }

    private async Task CastSpell(int spellBaseLevel, int slotLevelToUse)
    {
        bool success = await SpellService.CastSpellAsync(CharDto.Id, spellBaseLevel, slotLevelToUse);
        if (success)
        {
            await RefreshCharacterAsync();
        }
    }

    private async Task RefreshCharacterAsync()
    {
        var updated = await CharacterService.GetByIdAsync(CharDto.Id, q => q.Include(x => x.KnownSpells).Include(x => x.SpellSlots));
        if (updated != null)
        {
            CharDto = updated;
            await OnCharacterUpdated.InvokeAsync();
        }
    }
}
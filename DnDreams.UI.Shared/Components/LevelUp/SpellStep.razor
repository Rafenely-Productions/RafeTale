@using DnDreams.Domain.Entities;
@using DnDreams.Domain.Enums;
@inject IUnitOfWork UnitOfWork

<div class="space-y-4">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <h3 class="text-xl font-bold text-blue-400">Libro de Conjuros</h3>
            <p class="text-xs text-slate-500">Selecciona los hechizos que tu héroe ha aprendido.</p>
        </div>
        <div class="relative w-full md:w-64">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-500"></i>
            <input @bind-value="SearchTerm" @bind-value:event="oninput"
                   placeholder="Buscar por nombre..."
                   class="w-full bg-slate-800 border border-slate-700 rounded-xl pl-10 pr-4 py-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-all" />
        </div>
    </div>

    <div class="flex gap-2 overflow-x-auto pb-2 custom-scrollbar">
        @for (int i = 0; i <= 3; i++) // Filtramos hasta nivel 3 por ahora
        {
            SpellLevel level = (SpellLevel) i;
            <button @onclick="() => FilterLevel = level"
                    class="px-4 py-1 rounded-full text-xs font-bold transition-all @(FilterLevel == level ? "bg-blue-600 text-white" : "bg-slate-800 text-slate-400 hover:bg-slate-700")">
                Nivel @(level == 0 ? "0 (Truco)" : level.ToString())
            </button>
        }
        <button @onclick="() => FilterLevel = null" class="px-4 py-1 rounded-full text-xs bg-slate-800 text-slate-400">Todos</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 max-h-[380px] overflow-y-auto pr-2 custom-scrollbar">
        @foreach (var spell in FilteredSpells)
        {
            <div @onclick="() => ToggleSpell(spell.Id)"
                 class="p-3 bg-slate-900 border-2 rounded-xl cursor-pointer transition-all @(State.SelectedSpellIds.Contains(spell.Id) ? "border-blue-500 bg-blue-900/10" : "border-slate-800 hover:border-slate-700")">
                <div class="flex justify-between items-center">
                    <span class="font-bold text-slate-200">@spell.TechnicalName</span>
                    @if (State.SelectedSpellIds.Contains(spell.Id))
                    {
                        <i class="fa-solid fa-sparkles text-blue-400"></i>
                    }
                </div>
                <div class="flex gap-2 mt-1">
                    <span class="text-[9px] uppercase font-bold text-blue-300 bg-blue-900/30 px-1.5 py-0.5 rounded">@spell.School</span>
                    <span class="text-[9px] uppercase font-bold text-slate-500 bg-slate-800 px-1.5 py-0.5 rounded">@spell.Range</span>
                </div>
                <p class="text-[10px] text-slate-500 mt-2 line-clamp-2">//spell.Description</p>
            </div>
        }
    </div>

    <div class="p-3 bg-blue-900/20 border border-blue-800/50 rounded-xl flex justify-between items-center">
        <span class="text-sm text-blue-200">Hechizos seleccionados: <strong>@State.SelectedSpellIds.Count</strong></span>
        <button @onclick="() => State.SelectedSpellIds.Clear()" class="text-[10px] text-blue-400 hover:underline">Limpiar selección</button>
    </div>
</div>

@code {
    [Parameter] public LevelUpState State { get; set; } = null!;
    private List<Spell> AllSpells = new();
    private string SearchTerm = "";
    private SpellLevel? FilterLevel = null;

    protected override async Task OnInitializedAsync()
    {
        // Traemos los 361 hechizos del catálogo maestro
        AllSpells = (await UnitOfWork.Spells.GetAllAsync()).ToList();
    }

    private IEnumerable<Spell> FilteredSpells => AllSpells
        .Where(s => (string.IsNullOrEmpty(SearchTerm) || s.TechnicalName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)) &&
                    (!FilterLevel.HasValue || s.Level == FilterLevel.Value))
        .OrderBy(s => s.Level)
        .ThenBy(s => s.TechnicalName);

    private void ToggleSpell(Guid id)
    {
        if (State.SelectedSpellIds.Contains(id))
            State.SelectedSpellIds.Remove(id);
        else
            State.SelectedSpellIds.Add(id);
    }
}

<div class="space-y-6 animate-fade-in">
    <div class="text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-red-900/30 rounded-full mb-4 border border-red-500/50">
            <i class="fa-solid fa-heart-pulse text-3xl text-red-500"></i>
        </div>
        <h3 class="text-2xl font-black text-white">Incremento de Vitalidad</h3>
        <p class="text-slate-400">Tu clase (@Character.ClassDef.Name) usa un dado <span class="text-red-400 font-bold">@Character.ClassDef.HitDie</span></p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div @onclick="() => SelectHp(FixedValue)"
             class="relative p-6 bg-slate-900 border-2 rounded-3xl cursor-pointer transition-all @(State.SelectedHp == FixedValue ? "border-red-500 shadow-[0_0_20px_rgba(239,68,68,0.2)]" : "border-slate-800 hover:border-slate-700")">
            <div class="flex justify-between items-start mb-4">
                <span class="text-xs font-bold uppercase tracking-widest text-slate-500">Sugerido</span>
                @if (State.SelectedHp == FixedValue)
                {
                    <i class="fa-solid fa-circle-check text-red-500 text-xl"></i>
                }
            </div>
            <h4 class="text-lg font-bold text-white">Valor Promedio</h4>
            <div class="text-4xl font-black text-red-500 my-2">+@FixedValue</div>
            <p class="text-xs text-slate-500">Consistencia ante todo. @(Character.ClassDef.HitDieValue / 2 + 1) base + @Character.ConModifier de Con.</p>
        </div>

        <div @onclick="RollDice"
             class="relative p-6 bg-slate-900 border-2 rounded-3xl cursor-pointer transition-all @(State.SelectedHp > 0 && State.SelectedHp != FixedValue ? "border-amber-500 shadow-[0_0_20px_rgba(245,158,11,0.2)]" : "border-slate-800 hover:border-slate-700")">
            <div class="flex justify-between items-start mb-4">
                <span class="text-xs font-bold uppercase tracking-widest text-slate-500">Azar</span>
                @if (State.SelectedHp > 0 && State.SelectedHp != FixedValue)
                {
                    <i class="fa-solid fa-dice text-amber-500 text-xl"></i>
                }
            </div>
            <h4 class="text-lg font-bold text-white">Tirar el @Character.ClassDef.HitDie</h4>
            <div class="text-4xl font-black text-amber-500 my-2">@(IsRolling ? "..." : $"+{State.SelectedHp}")</div>
            <p class="text-xs text-slate-500">¿Te sientes con suerte? El resultado mínimo es 1 + @Character.ConModifier de Con.</p>
        </div>
    </div>

    @if (HasToughFeat)
    {
        <div class="p-3 bg-blue-900/20 border border-blue-500/30 rounded-xl flex items-center gap-3">
            <i class="fa-solid fa-shield-heart text-blue-400"></i>
            <p class="text-[11px] text-blue-200">
                <strong>Dote Robustez detectado:</strong> Se sumarán automáticamente +2 HP extra a tu total por este nivel.
            </p>
        </div>
    }
</div>

@code {
    [Parameter] public LevelUpState State { get; set; } = null!;
    [Parameter] public Character Character { get; set; } = null!;

    private bool IsRolling = false;
    private int FixedValue => (Character.ClassDef.HitDieValue / 2) + 1 + Character.ConModifier;

    // Verificamos si el jugador seleccionó el dote de Robustez en el paso anterior
    private bool HasToughFeat => State.SelectedFeatId.HasValue &&
                                 // Aquí deberías comparar contra el Guid real de tu base de datos para 'Robustez'
                                 State.SelectedFeatId.ToString().Contains("GUID_DE_ROBUSTEZ_AQUI");

    private void SelectHp(int val)
    {
        State.SelectedHp = val;
    }

    private async Task RollDice()
    {
        IsRolling = true;
        State.SelectedHp = 0;
        await Task.Delay(600); // Efecto visual de suspenso

        var random = new Random();
        int roll = random.Next(1, Character.ClassDef.HitDieValue + 1);
        State.SelectedHp = roll + Character.ConModifier;

        IsRolling = false;
    }
}
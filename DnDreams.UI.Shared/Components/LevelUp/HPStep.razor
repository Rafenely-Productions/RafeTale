@using DnDreams.Application.DTOs
@inject IStringLocalizer<AppStrings> L

<div class="space-y-6 animate-in fade-in duration-200">
    <div>
        <h2 class="text-base sm:text-lg font-black text-white uppercase tracking-wide">@L["Title_HitPointsGain"]</h2>
        <p class="text-xs text-slate-400 mt-1">
            @L["Desc_HitPointsGain"] (@Character.ClassDef?.Name: 1d@Character.ClassDef?.HitDie).
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        @* Opción: Promedio *@
        <div @onclick="SelectAverageHp"
             class="p-4 sm:p-5 rounded-2xl border cursor-pointer transition-all flex items-center justify-between bg-black/30 @(Draft.UseAverageHp ? "border-amber-500 bg-amber-500/[0.02]" : "border-slate-800 hover:border-amber-500/30")">
            <div class="space-y-1">
                <p class="text-xs sm:text-sm font-bold text-white uppercase">@L["Option_FixedAverage"]</p>
                <p class="text-[11px] text-slate-400">@L["Desc_FixedAverage"] (+@AverageHpBase + CON mod)</p>
            </div>
            <span class="text-xl sm:text-2xl font-black text-amber-500 font-mono">+@CalculateHpGain(true) HP</span>
        </div>

        @* Opción: Tirada *@
        <div @onclick="RollHp"
             class="p-4 sm:p-5 rounded-2xl border cursor-pointer transition-all flex items-center justify-between bg-black/30 @(!Draft.UseAverageHp ? "border-amber-500 bg-amber-500/[0.02]" : "border-slate-800 hover:border-amber-500/30")">
            <div class="space-y-1">
                <p class="text-xs sm:text-sm font-bold text-white uppercase">@L["Option_RollDice"]</p>
                <p class="text-[11px] text-slate-400">@L["Desc_RollDice"] (1d@Character.ClassDef?.HitDie + CON mod)</p>
            </div>
            <div class="flex items-center gap-3">
                @if (HasRolled)
                {
                    <span class="text-xl sm:text-2xl font-black text-lime-500 font-mono">+@CalculateHpGain(false) HP</span>
                }
                else
                {
                    <button @onclick="RollHp" @onclick:stopPropagation
                            class="px-3 py-1.5 rounded-xl bg-amber-500 text-black text-[10px] font-black uppercase tracking-wider flex items-center gap-1.5 shadow-md">
                        <i class="fa-solid fa-dice-d20 text-xs"></i> @L["Btn_Roll"]
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public LevelUpDraft Draft { get; set; } = null!;
    [Parameter] public CharacterDto Character { get; set; } = null!;
    [Parameter] public int AverageHpBase { get; set; }
    [Parameter] public EventCallback OnHpSelected { get; set; }

    private bool HasRolled = false;
    private int DiceRollResult = 0;

    private void SelectAverageHp()
    {
        Draft.UseAverageHp = true;
        Draft.HpGain = AverageHpBase + Character.ConModifier;
        OnHpSelected.InvokeAsync();
    }

    private void RollHp()
    {
        Draft.UseAverageHp = false;
        if (!HasRolled)
        {
            var random = new Random();
            DiceRollResult = random.Next(1, (Character.ClassDef?.HitDieValue ?? 8) + 1);
            Draft.HpGain = Math.Max(1, DiceRollResult + Character.ConModifier);
            HasRolled = true;
        }
        OnHpSelected.InvokeAsync();
    }

    private int CalculateHpGain(bool useAverage)
    {
        if (useAverage) return AverageHpBase + Character.ConModifier;
        return HasRolled ? DiceRollResult + Character.ConModifier : 0;
    }
}

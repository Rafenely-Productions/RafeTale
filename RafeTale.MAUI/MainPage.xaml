<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RafeTale.MAUI"
             xmlns:components="clr-namespace:RafeTale.MAUI.Components"
             x:Class="RafeTale.MAUI.MainPage"
             BackgroundColor="#121212">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html" BackgroundColor="Transparent">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app"
                    ComponentType="{x:Type local:Main}"/>
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
